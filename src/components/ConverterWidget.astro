---
import { FOODS, FROZEN_FOODS, type FoodKey, type FrozenFoodKey } from '../lib/converter';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, OVEN_MARK_SCALE, type LocaleCode } from '../i18n/locales';

interface Props {
  locale?: LocaleCode;
  /**
   * 'convection' converts a fan-oven recipe with the gentler CONVECTION_FOODS table;
   * 'frozen' converts frozen-pack instructions with FROZEN_FOODS and adds the pack-type
   * toggle, shake/flip marks, internal temperature and raw-chicken warning.
   */
  source?: 'oven' | 'convection' | 'frozen';
  /** Oven °F the temperature input starts at (the /[temp]-to-air-fryer landing pages); still fully editable. */
  initialTemp?: number;
  /** Oven minutes the time input starts at (the /air-fryer/[food] presets); still fully editable. */
  initialTime?: number;
  /** Food preselected in the dropdown (the /air-fryer/[food] presets): a FROZEN_FOODS key when source is 'frozen'; still fully editable. */
  initialFood?: FoodKey | FrozenFoodKey;
  /** Frozen mode: the preset's own turn type/count for `initialFood` (applies only while that food is selected). */
  initialTurn?: { turn: 'shake' | 'flip'; turns: number };
  /** Temperature unit the initialTemp is in (°F or °C). */
  initialUnit?: 'F' | 'C';
  /**
   * Brand pages: a model picker. Choosing a model sets its style and clamps to its own air-fry
   * maximum (engine `maxF`); the "any model" option keeps today's 400/450 style ceiling.
   */
  models?: { id: string; label: string; style: 'basket' | 'oven'; maxF: number }[];
  modelLabels?: { picker: string; any: string };
}

const { locale = DEFAULT_LOCALE, source = 'oven', initialTemp, initialTime, initialFood, initialTurn, models = [], modelLabels } = Astro.props;
const turnOverride = initialTurn && initialFood ? { food: initialFood, ...initialTurn } : null;
const markScale = OVEN_MARK_SCALE[locale];
const all = getDictionary(locale);
const baseDict = all.converter;
const frozenDict = source === 'frozen' ? all.frozenConverter : null;
const dict =
  source === 'convection'
    ? { ...baseDict, ...all.convectionConverter }
    : frozenDict
      ? { ...baseDict, widgetLabel: frozenDict.widgetLabel, ovenTemperature: frozenDict.ovenTemperature, ovenTime: frozenDict.ovenTime }
      : baseDict;

const foodOptions = frozenDict
  ? (Object.keys(FROZEN_FOODS) as FrozenFoodKey[]).map((key) => ({ key, ...frozenDict.foods[key] }))
  : (Object.keys(FOODS) as FoodKey[]).map((key) => ({ key, ...baseDict.foods[key] }));
const tips = Object.fromEntries(foodOptions.map(({ key, tip }) => [key, tip]));
const defaultFood = initialFood ?? (frozenDict ? 'fries' : 'general');
// A typical US frozen-fries pack (425°F / 20 min) vs. the flagship's 400°F / 25 min oven recipe.
const defaults = frozenDict ? { temp: initialTemp ?? 425, time: initialTime ?? 20 } : { temp: initialTemp ?? 400, time: initialTime ?? 25 };
---

<div class="widget-card">
  <div class="widget-head">
    <span>{dict.widgetLabel}</span>
    <span class="live-badge"><span class="dot"></span>{dict.live}</span>
  </div>

  <div class="field-row">
    <div class="field grow">
      <label for="afk-temp">{dict.ovenTemperature}</label>
      <div class="input-with-toggle">
        <input id="afk-temp" type="number" inputmode="numeric" value={defaults.temp} />
        <button type="button" id="afk-unit-f" class="seg-btn" aria-pressed="true">°F</button>
        <button type="button" id="afk-unit-c" class="seg-btn" aria-pressed="false">°C</button>
      </div>
    </div>
    <div class="field narrow">
      <label for="afk-time">{dict.ovenTime}</label>
      <div class="input-with-suffix">
        <input id="afk-time" type="number" inputmode="numeric" value={defaults.time} />
        <span class="suffix">{dict.min}</span>
      </div>
    </div>
  </div>

  {models.length > 0 && modelLabels && (
    <div class="field-row">
      <div class="field">
        <label for="afk-model">{modelLabels.picker}</label>
        <select id="afk-model">
          <option value="">{modelLabels.any}</option>
          {models.map((m) => (
            <option value={m.id}>{m.label}</option>
          ))}
        </select>
      </div>
    </div>
  )}

  {frozenDict && (
    <div class="field-row">
      <div class="field">
        <span class="field-label">{frozenDict.packType}</span>
        <div class="input-with-toggle wide">
          <button type="button" id="afk-pack-conventional" class="seg-btn wide" aria-pressed="true">{frozenDict.packConventional}</button>
          <button type="button" id="afk-pack-fan" class="seg-btn wide" aria-pressed="false">{frozenDict.packFan}</button>
        </div>
      </div>
    </div>
  )}

  <div class="field-row">
    <div class="field">
      <label for="afk-food">{dict.foodType}</label>
      <select id="afk-food">
        {foodOptions.map(({ key, label }) => (
          <option value={key} selected={key === defaultFood}>{label}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <span class="field-label">{dict.airFryerStyle}</span>
      <div class="input-with-toggle wide">
        <button type="button" id="afk-style-basket" class="seg-btn wide" aria-pressed="true">{dict.basket}</button>
        <button type="button" id="afk-style-oven" class="seg-btn wide" aria-pressed="false">{dict.ovenStyle}</button>
      </div>
    </div>
  </div>

  <div class="result-panel" role="status" aria-live="polite">
    <p class="result-eyebrow">{dict.airFryerSetting}</p>
    <div class="result-row">
      <span id="afk-out-main" class="result-main">—</span>
      <span id="afk-out-alt" class="result-alt">/ —</span>
      <span class="spacer"></span>
      <span id="afk-out-time" class="result-time">—</span>
      <span class="result-alt">{dict.min}</span>
    </div>
    <div class="result-meta">
      <span>{dict.checkAt} <span id="afk-check-at">—</span> {dict.min}</span>
      <span>{dict.preheat} <span id="afk-preheat">—</span></span>
      <span id="afk-gas-mark">{dict.gasMarkDash}</span>
      {frozenDict && <span id="afk-turns"></span>}
      {frozenDict && <span id="afk-internal" hidden></span>}
    </div>
  </div>

  <p id="afk-tip" class="tip"></p>
  <p id="afk-capped" class="capped-note" hidden>
    <span class="capped-dot"></span>
    <span id="afk-capped-text"></span>
  </p>
  {frozenDict && (
    <p id="afk-raw" class="capped-note" hidden>
      <span class="capped-dot"></span>
      <span id="afk-raw-text"></span>
    </p>
  )}

  <slot />
</div>

<script is:inline define:vars={{ dict, source, frozenDict, tips, markScale, turnOverride, models }}>
  window.__afkDict = dict;
  window.__afkModels = models;
  window.__afkTurnOverride = turnOverride;
  window.__afkSource = source;
  window.__afkFrozenDict = frozenDict;
  window.__afkTips = tips;
  window.__afkMarkScale = markScale;
</script>

<script>
  import {
    computeAirFryerSetting,
    computeAirFryerSettingFromConvection,
    computeAirFryerSettingFromFrozen,
    cappedNote,
    ovenMarkFor,
    type ConversionResult,
    type FoodKey,
    type FrozenConversionResult,
    type FrozenFoodKey,
    type FryerStyle,
    type OvenMarkScale,
    type PackType,
    type TempUnit,
  } from '../lib/converter';
  import { preheatForSetting } from '../lib/preheat';
  import type { Dictionary } from '../i18n/types';

  const {
    __afkDict: dict,
    __afkSource: source,
    __afkFrozenDict: frozenDict,
    __afkTips: tips,
    __afkMarkScale: markScale,
    __afkTurnOverride: turnOverride,
    __afkModels: models,
  } = window as unknown as {
    __afkDict: Dictionary['converter'];
    __afkSource: 'oven' | 'convection' | 'frozen';
    __afkFrozenDict: Dictionary['frozenConverter'] | null;
    __afkTips: Record<string, string>;
    __afkMarkScale: OvenMarkScale;
    __afkTurnOverride: { food: string; turn: 'shake' | 'flip'; turns: number } | null;
    __afkModels: { id: string; label: string; style: FryerStyle; maxF: number }[];
  };

  const tempInput = document.getElementById('afk-temp') as HTMLInputElement;
  const timeInput = document.getElementById('afk-time') as HTMLInputElement;
  const foodSelect = document.getElementById('afk-food') as unknown as HTMLSelectElement;
  const unitFBtn = document.getElementById('afk-unit-f') as HTMLButtonElement;
  const unitCBtn = document.getElementById('afk-unit-c') as HTMLButtonElement;
  const styleBasketBtn = document.getElementById('afk-style-basket') as HTMLButtonElement;
  const styleOvenBtn = document.getElementById('afk-style-oven') as HTMLButtonElement;
  const outMain = document.getElementById('afk-out-main')!;
  const outAlt = document.getElementById('afk-out-alt')!;
  const outTime = document.getElementById('afk-out-time')!;
  const checkAt = document.getElementById('afk-check-at')!;
  const preheat = document.getElementById('afk-preheat')!;
  const gasMarkEl = document.getElementById('afk-gas-mark')!;
  const tipEl = document.getElementById('afk-tip')!;
  const cappedEl = document.getElementById('afk-capped') as HTMLElement;
  const cappedTextEl = document.getElementById('afk-capped-text')!;
  const packConventionalBtn = document.getElementById('afk-pack-conventional');
  const packFanBtn = document.getElementById('afk-pack-fan');
  const turnsEl = document.getElementById('afk-turns');
  const internalEl = document.getElementById('afk-internal');
  const rawEl = document.getElementById('afk-raw');
  const rawTextEl = document.getElementById('afk-raw-text');
  const modelSelect = document.getElementById('afk-model') as HTMLSelectElement | null;
  const selectedModel = () => models.find((m) => m.id === modelSelect?.value);

  const state: { unit: TempUnit; style: FryerStyle; pack: PackType } = { unit: 'F', style: 'basket', pack: 'conventional' };

  // /frozen?food=wings (the homepage teaser's Go button) opens with that food selected.
  const requestedFood = new URLSearchParams(window.location.search).get('food');
  if (requestedFood && [...foodSelect.options].some((o) => o.value === requestedFood)) foodSelect.value = requestedFood;

  function joinTimes(times: number[], listJoin: string): string {
    if (times.length <= 1) return times.join('');
    return `${times.slice(0, -1).join(', ')}${listJoin}${times[times.length - 1]}`;
  }

  function renderFrozen(result: FrozenConversionResult, fd: Dictionary['frozenConverter']) {
    if (turnsEl) {
      turnsEl.textContent =
        result.turns === 0 || result.turnAtMinutes.length === 0
          ? fd.noTurn
          : fd.turnAtTemplate
              .replace('{action}', result.turn === 'shake' ? fd.shake : fd.flip)
              .replace('{times}', joinTimes(result.turnAtMinutes, fd.listJoin));
    }
    const hasInternal = result.internalF !== null;
    const fill = (template: string) => template.replace('{f}', String(result.internalF)).replace('{c}', String(result.internalC));
    if (internalEl) {
      internalEl.hidden = !hasInternal;
      internalEl.textContent = hasInternal ? fill(fd.internalTemplate) : '';
    }
    if (rawEl && rawTextEl) {
      rawEl.hidden = !(result.raw && hasInternal);
      rawTextEl.textContent = result.raw && hasInternal ? fill(fd.rawWarningTemplate) : '';
    }
    packConventionalBtn?.classList.toggle('active', state.pack === 'conventional');
    packFanBtn?.classList.toggle('active', state.pack === 'fan');
  }

  function flash(el: HTMLElement) {
    el.classList.remove('flash');
    // eslint-disable-next-line no-void
    void el.offsetWidth;
    el.classList.add('flash');
  }

  function render() {
    const ovenTemp = parseFloat(tempInput.value);
    const ovenMinutes = parseFloat(timeInput.value);
    const food = foodSelect.value;
    const model = selectedModel();
    const base = { ovenTemp, unit: state.unit, ovenMinutes, style: state.style, maxF: model?.maxF };

    let result: ConversionResult;
    if (source === 'frozen' && frozenDict) {
      const turn = turnOverride && turnOverride.food === food ? { turn: turnOverride.turn, turns: turnOverride.turns } : undefined;
      const frozen = computeAirFryerSettingFromFrozen({ ...base, food: food as FrozenFoodKey, pack: state.pack, turnOverride: turn });
      renderFrozen(frozen, frozenDict);
      result = frozen;
    } else {
      const compute = source === 'convection' ? computeAirFryerSettingFromConvection : computeAirFryerSetting;
      result = compute({ ...base, food: food as FoodKey });
    }

    const ok = result.outF !== null;
    const okT = result.outMinutes !== null;

    outMain.textContent = ok ? `${state.unit === 'C' ? result.outC : result.outF}°${state.unit}` : '—';
    outAlt.textContent = ok ? `/ ${state.unit === 'C' ? result.outF : result.outC}°${state.unit === 'C' ? 'F' : 'C'}` : '/ —';
    outTime.textContent = okT ? String(result.outMinutes) : '—';
    checkAt.textContent = okT ? String(result.checkAtMinutes) : '—';
    const pre = preheatForSetting(result.outF, state.style);
    preheat.textContent = pre.kind === 'minutes' ? `${pre.minutes} ${dict.min}` : pre.kind === 'auto' ? dict.preheatAuto : '—';
    const mark = ovenMarkFor(result.outF, markScale);
    gasMarkEl.textContent = mark ? `${dict.gasMark} ${mark}` : dict.gasMarkDash;
    tipEl.textContent = tips[food] ?? '';

    if (result.capped) {
      cappedEl.hidden = false;
      const unitLabel = model ? model.label : state.style === 'oven' ? dict.unitOven : dict.unitBasket;
      cappedTextEl.textContent = cappedNote(dict.cappedNoteTemplate, unitLabel, result);
    } else {
      cappedEl.hidden = true;
    }

    unitFBtn.classList.toggle('active', state.unit === 'F');
    unitCBtn.classList.toggle('active', state.unit === 'C');
    styleBasketBtn.classList.toggle('active', state.style === 'basket');
    styleOvenBtn.classList.toggle('active', state.style === 'oven');

    flash(outMain);
    flash(outTime);
  }

  tempInput.addEventListener('input', render);
  timeInput.addEventListener('input', render);
  foodSelect.addEventListener('change', render);
  modelSelect?.addEventListener('change', () => {
    const model = selectedModel();
    if (model) state.style = model.style;
    render();
  });

  unitFBtn.addEventListener('click', () => {
    if (state.unit === 'F') return;
    const v = parseFloat(tempInput.value);
    if (Number.isFinite(v)) tempInput.value = String(Math.round(((v * 9) / 5 + 32) / 5) * 5);
    state.unit = 'F';
    unitFBtn.setAttribute('aria-pressed', 'true');
    unitCBtn.setAttribute('aria-pressed', 'false');
    render();
  });

  unitCBtn.addEventListener('click', () => {
    if (state.unit === 'C') return;
    const v = parseFloat(tempInput.value);
    if (Number.isFinite(v)) tempInput.value = String(Math.round(((v - 32) * 5) / 9 / 5) * 5);
    state.unit = 'C';
    unitFBtn.setAttribute('aria-pressed', 'false');
    unitCBtn.setAttribute('aria-pressed', 'true');
    render();
  });

  styleBasketBtn.addEventListener('click', () => {
    state.style = 'basket';
    styleBasketBtn.setAttribute('aria-pressed', 'true');
    styleOvenBtn.setAttribute('aria-pressed', 'false');
    render();
  });
  styleOvenBtn.addEventListener('click', () => {
    state.style = 'oven';
    styleBasketBtn.setAttribute('aria-pressed', 'false');
    styleOvenBtn.setAttribute('aria-pressed', 'true');
    render();
  });
  packConventionalBtn?.addEventListener('click', () => {
    state.pack = 'conventional';
    packConventionalBtn?.setAttribute('aria-pressed', 'true');
    packFanBtn?.setAttribute('aria-pressed', 'false');
    render();
  });
  packFanBtn?.addEventListener('click', () => {
    state.pack = 'fan';
    packConventionalBtn?.setAttribute('aria-pressed', 'false');
    packFanBtn?.setAttribute('aria-pressed', 'true');
    render();
  });

  render();
</script>

<style>
  @reference '../styles/global.css';

  .eyebrow {
    font-size: var(--text-eyebrow);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin: 0 0 24px;
  }

  .widget-card {
    flex: 1 1 440px;
    min-width: min(300px, 100%);
    background: var(--site-bg-card);
    border: 1px solid var(--site-hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-site);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .widget-card .eyebrow {
    margin: 0 0 4px;
  }

  .widget-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-eyebrow);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 4px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--site-text);
  }

  .dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--site-accent);
  }

  .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .field-row:first-of-type {
    margin-top: 0;
  }

  .field {
    flex: 1 1 200px;
    min-width: min(180px, 100%);
  }

  .field.grow {
    flex: 1 1 240px;
    min-width: min(230px, 100%);
  }

  .field.narrow {
    flex: 0 1 140px;
    min-width: min(130px, 100%);
  }

  .field label,
  .field-label {
    display: block;
    font-family: var(--font-archivo);
    font-size: 13px;
    font-weight: 600;
    color: var(--site-text-body);
    margin-bottom: 8px;
  }

  .field input,
  .field select {
    height: 48px;
    padding: 0 16px;
    border: 1px solid var(--site-input-border);
    border-radius: var(--radius-md);
    background: var(--site-bg-field);
    color: var(--site-text);
    font-family: var(--font-archivo);
    font-size: 15px;
    width: 100%;
  }

  .field input {
    font-size: 20px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-archivo);
  }

  .field select {
    cursor: pointer;
  }

  .input-with-toggle,
  .input-with-suffix {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .input-with-toggle input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .input-with-toggle.wide {
    width: 100%;
  }

  .input-with-suffix input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .suffix {
    font-size: 13px;
    color: var(--site-text-muted);
    margin-right: 12px;
  }

  .seg-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 14px;
    border-radius: var(--radius-sm);
    font-family: var(--font-archivo);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    flex: 0 0 auto;
    background: var(--site-bg-segment);
    border: 1px solid transparent;
    color: var(--site-text-muted);
    transition: all 0.12s ease;
  }

  .seg-btn.wide {
    flex: 1 1 0;
    min-width: 0;
  }

  .seg-btn.active {
    background: var(--site-bg-card);
    border: 1px solid transparent;
    color: var(--site-text);
    box-shadow: 0 1px 2px rgba(30,30,30,0.08);
    font-weight: 600;
  }

  .result-panel {
    margin-top: 8px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    background: var(--site-panel);
    color: var(--site-on-panel);
  }

  .result-eyebrow {
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--text-caption--letter-spacing);
    color: var(--site-accent);
    margin: 0 0 12px;
  }

  .result-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
  }

  .result-main {
    font-family: var(--font-display);
    font-size: var(--text-result);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.0;
    font-variant-numeric: tabular-nums;
    color: var(--site-on-panel);
    transition: color 0.32s ease;
  }

  .result-main.flash {
    animation: flash-color 0.32s ease;
  }

  @keyframes flash-color {
    0% {
      color: var(--site-accent);
    }
    100% {
      color: var(--site-on-panel);
    }
  }

  .result-alt {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-on-panel-muted);
    line-height: 1;
  }

  .result-time {
    font-family: var(--font-archivo);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.0;
    color: var(--site-on-panel);
    font-variant-numeric: tabular-nums;
  }

  .spacer {
    flex: 1 1 auto;
  }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--site-on-panel-muted);
    font-family: var(--font-archivo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-on-panel-muted);
  }

  .tip {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 16px 0 0;
    min-height: 1.5em;
  }

  .capped-note {
    display: flex;
    gap: 10px;
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text);
    background: var(--site-bg-deep);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    margin: 12px 0 0;
    animation: afk-rise 0.22s ease both;
  }

  .capped-dot {
    flex: 0 0 auto;
    margin-top: 8px;
    width: 6px;
    height: 6px;
    background: var(--site-accent);
    border-radius: 999px;
  }
</style>