---
import AdSlot from './AdSlot.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { FOODS, computeAirFryerSetting, formatTempAdjustment, type FoodKey } from '../lib/converter';
import { TEMP_STEPS, TIME_STEPS } from '../lib/chart-data';
import { LIVE_PAGES } from '../site.config';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale).chart;
const converterDict = getDictionary(locale).converter;

const tempRows = TEMP_STEPS.map((ovenF) => ({
  ovenF,
  ...computeAirFryerSetting({ ovenTemp: ovenF, unit: 'F', ovenMinutes: 20, food: 'general', style: 'basket' }),
}));

const timeRows = TIME_STEPS.map((ovenMinutes) => ({
  ovenMinutes,
  outMinutes: computeAirFryerSetting({ ovenTemp: 400, unit: 'F', ovenMinutes, food: 'general', style: 'basket' })
    .outMinutes,
}));

const foodKeys = Object.keys(FOODS) as FoodKey[];
const foodRows = foodKeys.map((key) => ({
  key,
  label: converterDict.foods[key].label,
  note: converterDict.foods[key].tip,
  dT: FOODS[key].dT,
  f: FOODS[key].f,
}));

const workedFlat = computeAirFryerSetting({ ovenTemp: 350, unit: 'F', ovenMinutes: 30, food: 'general', style: 'basket' });
const workedBaked = computeAirFryerSetting({ ovenTemp: 350, unit: 'F', ovenMinutes: 30, food: 'baked', style: 'basket' });

const workedExampleBody = dict.workedExampleTemplate
  .replace('{FLAT_F}', String(workedFlat.outF))
  .replace('{FLAT_MIN}', String(workedFlat.outMinutes))
  .replace('{BAKED_F}', String(workedBaked.outF))
  .replace('{BAKED_MIN}', String(workedBaked.outMinutes));

const [ceilingBefore, ceilingAfter] = dict.ceilingNoteTemplate.split('{link}');

const converterHref = localizedPath(locale, '/oven-to-air-fryer');
const gasMarkSlug = '/fahrenheit-celsius-gas-mark';
const gasMarkLive = LIVE_PAGES.has(gasMarkSlug);
const gasMarkHref = localizedPath(locale, gasMarkSlug);
const reverseSlug = '/air-fryer-to-oven';
const reverseLive = LIVE_PAGES.has(reverseSlug);
const reverseHref = localizedPath(locale, reverseSlug);
const convectionSlug = '/convection-to-air-fryer';
const convectionLive = LIVE_PAGES.has(convectionSlug);
const convectionHref = localizedPath(locale, convectionSlug);
const reverseConvectionSlug = '/air-fryer-to-convection';
const reverseConvectionLive = LIVE_PAGES.has(reverseConvectionSlug);
const reverseConvectionHref = localizedPath(locale, reverseConvectionSlug);
const frozenSlug = '/frozen';
const frozenLive = LIVE_PAGES.has(frozenSlug);
const frozenHref = localizedPath(locale, frozenSlug);
---

<main class="page-main">
  <div class="wrap">

    <header class="chart-header">
      <a href={converterHref} class="back-link">&larr; {dict.backLink}</a>
      <p class="page-tag">{dict.pageTag}</p>
      <h1>{dict.heading}</h1>
      <p class="chart-lead">{dict.lead}</p>
      <button type="button" id="chart-print-btn" class="print-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          <rect x="5" y="8" width="14" height="7"></rect>
          <path d="M7 8V4h10v4M7 15v5h10v-5"></path>
        </svg>
        {dict.printButton}
      </button>
    </header>

    <section class="print-chart" aria-label="Printable conversion tables">

      <div class="table-grid">
        <div class="table-card">
          <h2>{dict.tempTableHeading}</h2>
          <table>
            <thead>
              <tr><th>{dict.tempHeaders.ovenF}</th><th>{dict.tempHeaders.airFryerF}</th><th>{dict.tempHeaders.airFryerC}</th><th>{dict.tempHeaders.gasMark}</th></tr>
            </thead>
            <tbody>
              {tempRows.map((r) => (
                <tr>
                  <td>{r.ovenF}°F</td>
                  <td>{r.outF}°F{r.capped && <sup>&dagger;</sup>}</td>
                  <td>{r.outC}°C</td>
                  <td>{r.gasMark ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="table-footnote">{dict.tempFootnote}</p>
        </div>

        <div class="table-card">
          <h2>{dict.timeTableHeading}</h2>
          <table>
            <thead>
              <tr><th>{dict.timeHeaders.ovenTime}</th><th>{dict.timeHeaders.airFryerTime}</th></tr>
            </thead>
            <tbody>
              {timeRows.map((r) => (
                <tr><td>{r.ovenMinutes} {converterDict.min}</td><td>{r.outMinutes} {converterDict.min}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="table-card food-table">
        <h2>{dict.foodTableHeading}</h2>
        <table>
          <thead>
            <tr><th>{dict.foodHeaders.food}</th><th>{dict.foodHeaders.tempAdjustment}</th><th>{dict.foodHeaders.timeMultiplier}</th><th>{dict.foodHeaders.note}</th></tr>
          </thead>
          <tbody>
            {foodRows.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td>{formatTempAdjustment(r.dT)}</td>
                <td>&times;{r.f}</td>
                <td>{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="ceiling-note">{ceilingBefore}<a href={converterHref}>{dict.liveConverterLabel}</a>{ceilingAfter}</p>
    </section>

    <AdSlot slot="4455667788" />

    <section class="content-section">
      <h2>{dict.howToReadHeading}</h2>
      <p>{dict.howToReadBody}</p>

      <h3>{dict.whyFlatRuleHeading}</h3>
      <p>{dict.whyFlatRuleBody}</p>
      <p>{workedExampleBody}</p>
    </section>

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <div class="faq-list">
        {dict.faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="related-links">
      <h2>{dict.relatedHeading}</h2>
      <ul>
        <li><a href={converterHref}>{dict.relatedConverterLabel}</a> {dict.relatedConverterDesc}</li>
        {gasMarkLive && (
          <li><a href={gasMarkHref}>{dict.relatedGasMarkLabel}</a> {dict.relatedGasMarkDesc}</li>
        )}
        {reverseLive && (
          <li><a href={reverseHref}>{dict.relatedReverseLabel}</a> {dict.relatedReverseDesc}</li>
        )}
        {convectionLive && (
          <li><a href={convectionHref}>{dict.relatedConvectionLabel}</a> {dict.relatedConvectionDesc}</li>
        )}
        {reverseConvectionLive && (
          <li><a href={reverseConvectionHref}>{dict.relatedReverseConvectionLabel}</a> {dict.relatedReverseConvectionDesc}</li>
        )}
        {frozenLive && (
          <li><a href={frozenHref}>{dict.relatedFrozenLabel}</a> {dict.relatedFrozenDesc}</li>
        )}
      </ul>
    </section>

  </div>
</main>

<script>
  document.getElementById('chart-print-btn')?.addEventListener('click', () => window.print());
</script>

<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: 960px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: 40px 0 80px;
  }

  .chart-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  .page-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--site-accent);
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .chart-lead {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 20px;
    max-width: 64ch;
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border: 1px solid var(--site-border);
    border-radius: var(--radius-site-card);
    background: var(--site-text);
    color: var(--site-bg-card);
    font-family: var(--font-archivo);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .print-btn:hover {
    background: var(--site-accent);
    border-color: var(--site-accent);
  }

  .print-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .print-chart {
    margin-bottom: 8px;
  }

  .table-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .table-card {
    background: var(--site-bg-card);
    border-radius: var(--radius-site-card);
    box-shadow: var(--shadow-site);
    padding: 20px;
  }

  .table-card h2 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.15px;
    color: var(--site-text);
    margin: 0 0 12px;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  th, td {
    text-align: left;
    padding: 8px 6px;
    border-bottom: 1px solid var(--site-border);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--site-text);
    word-break: break-word;
  }

  th {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--site-text-muted);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  .food-table td:last-child,
  .food-table th:last-child {
    width: 40%;
  }

  .table-footnote {
    font-size: 12px;
    color: var(--site-text-muted);
    margin: 10px 0 0;
  }

  .ceiling-note {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text);
    background: var(--site-bg-card);
    border-radius: var(--radius-site-card);
    box-shadow: var(--shadow-site);
    padding: 16px 20px;
    margin: 0;
  }

  .ceiling-note a {
    font-weight: 600;
  }

  .content-section,
  .faq-section,
  .related-links {
    margin: 40px 0;
  }

  .content-section h2,
  .faq-section h2,
  .related-links h2 {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .content-section h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.18px;
    color: var(--site-text);
    margin: 28px 0 8px;
  }

  .content-section p {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 16px;
    max-width: 72ch;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    border-radius: var(--radius-site-card);
    background: var(--site-bg-card);
    box-shadow: var(--shadow-site);
    padding: 16px 20px;
  }

  .faq-item summary {
    font-size: 15px;
    font-weight: 600;
    color: var(--site-text);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    float: right;
    color: var(--site-text-muted);
    font-size: 20px;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: '\2212';
  }

  .faq-item p {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 12px 0 0;
  }

  .related-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-links li {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--site-text-muted);
    background: var(--site-bg-card);
    border-radius: var(--radius-site-card);
    box-shadow: var(--shadow-site);
    padding: 14px 18px;
  }

  .related-links a {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .table-grid {
      grid-template-columns: 1fr;
    }

    th, td {
      padding: 8px 4px;
      font-size: 12px;
    }

    .print-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media print {
    .back-link,
    .print-btn,
    .page-tag,
    .chart-lead,
    .content-section,
    .faq-section,
    .related-links {
      display: none !important;
    }

    .wrap {
      max-width: 100%;
      padding: 0;
    }

    h1 {
      font-size: 16pt;
      margin: 0 0 6pt;
    }

    .table-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10pt;
      margin-bottom: 10pt;
      break-inside: avoid;
    }

    .table-card {
      box-shadow: none;
      border: 1px solid #000;
      border-radius: 0;
      padding: 8pt;
      break-inside: avoid;
    }

    .table-card h2 {
      font-size: 11pt;
      color: #000;
      margin: 0 0 6pt;
    }

    table {
      font-size: 10pt;
    }

    th, td {
      border: 1px solid #000;
      color: #000;
      padding: 2pt 4pt;
      font-size: 10pt;
    }

    th {
      color: #000;
    }

    .table-footnote {
      font-size: 10pt;
      color: #000;
      margin-top: 6pt;
    }

    .ceiling-note {
      box-shadow: none;
      border: 1px solid #000;
      border-radius: 0;
      color: #000;
      font-size: 10pt;
      padding: 8pt 10pt;
      break-inside: avoid;
    }
  }
</style>
