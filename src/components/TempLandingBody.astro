---
import ConverterWidget from './ConverterWidget.astro';
import AdSlot from './AdSlot.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import {
  fillPlaceholders,
  tempLandingNeighbours,
  tempLandingRows,
  tempLandingSlug,
  tempLandingValues,
  type TempLanding,
  type TempLandingF,
} from '../lib/temp-landings';
import { LIVE_PAGES } from '../site.config';

interface Props {
  locale?: LocaleCode;
  landing: TempLanding;
}

const { locale = DEFAULT_LOCALE, landing } = Astro.props;
const all = getDictionary(locale);
const dict = all.tempLanding;
const copy = dict.pages[landing.tempF as TempLandingF];
const values = tempLandingValues(landing);
const fill = (text: string) => fillPlaceholders(text, values);

const rows = tempLandingRows(landing.tempF);
const generalCapped = rows.find((r) => r.food === 'general')!.basket.capped;
const answer = fill(generalCapped ? dict.answerCappedTemplate : dict.answerTemplate);
const anyCapped = rows.some((r) => r.basket.capped || r.oven.capped);

const cell = (r: (typeof rows)[number]['basket']) => ({
  temp: `${r.outF}°F / ${r.outC}°C`,
  meta: [r.gasMark ? `${all.converter.gasMark} ${r.gasMark}` : null, fillPlaceholders(dict.timeLessTemplate, { PCT: String(r.pct) })]
    .filter(Boolean)
    .join(' · '),
  capped: r.capped,
});
const tableRows = rows.map((r) => ({
  food: r.food,
  label: all.converter.foods[r.food].label,
  basket: cell(r.basket),
  oven: cell(r.oven),
}));

const { prev, next } = tempLandingNeighbours(landing.tempF);
const neighbourLinks = [prev, next]
  .filter((l): l is TempLanding => l !== null && LIVE_PAGES.has(tempLandingSlug(l.tempF)))
  .map((l) => ({
    href: localizedPath(locale, tempLandingSlug(l.tempF)),
    label: fillPlaceholders(dict.neighbourLinkTemplate, { OVEN_F: String(l.tempF) }),
  }));

const links = [
  { slug: '/oven-to-air-fryer', label: dict.relatedFlagshipLink },
  { slug: '/chart', label: dict.relatedChartLink },
  { slug: '/frozen', label: dict.relatedFrozenLink },
]
  .filter(({ slug }) => LIVE_PAGES.has(slug))
  .map(({ slug, label }) => ({ href: localizedPath(locale, slug), label }));
---

<main class="page-main">
  <div class="wrap">

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <p class="page-tag">{dict.pageTag}</p>
      <h1>{fill(copy.heading)}</h1>
      <p class="tool-desc">{fill(copy.subDesc)}</p>
    </header>

    <div class="direct-answer">
      <p id="tl-answer" class="answer-main">{answer}</p>
      <p id="tl-answer-oven" class="answer-alt">{fill(dict.answerOvenStyleTemplate)}</p>
    </div>

    <section class="tool-area" aria-label="Converter">
      <ConverterWidget locale={locale} initialTemp={landing.tempF} />
    </section>

    <AdSlot slot="6677889900" />

    <section class="table-section">
      <h2>{fill(dict.tableHeading)}</h2>
      <p class="table-intro">{dict.tableIntro}</p>
      <div class="table-card">
        <table id="tl-food-table">
          <thead>
            <tr><th>{dict.tableHeaders.food}</th><th>{dict.tableHeaders.basket}</th><th>{dict.tableHeaders.ovenStyle}</th></tr>
          </thead>
          <tbody>
            {tableRows.map((r) => (
              <tr data-food={r.food}>
                <td class="food-cell">{r.label}</td>
                {[r.basket, r.oven].map((c, i) => (
                  <td class:list={['result-cell', { capped: c.capped }]} data-style={i === 0 ? 'basket' : 'oven'}>
                    <span class="cell-temp">{c.temp}</span>
                    <span class="cell-meta">{c.meta}</span>
                    {c.capped && <span class="capped-chip">{dict.cappedCell}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {anyCapped && <p id="tl-capped-footnote" class="table-footnote">{fill(dict.cappedFootnote)}</p>}
    </section>

    <section class="content-section">
      <h2>{copy.recipesHeading}</h2>
      <p>{fill(copy.recipesBody)}</p>

      <h3>{copy.failureHeading}</h3>
      <p>{fill(copy.failureBody)}</p>

      <h3>{copy.workedExampleHeading}</h3>
      <p>{fill(copy.workedExampleTemplate)}</p>

      <h3>{copy.styleHeading}</h3>
      <p>{fill(copy.styleBody)}</p>

      {neighbourLinks.length > 0 && (
        <>
          <h3>{dict.neighboursHeading}</h3>
          {neighbourLinks.map(({ href, label }) => (
            <p class="related-link neighbour-link"><a href={href}>{label}</a> &rarr;</p>
          ))}
        </>
      )}

      {links.map(({ href, label }) => (
        <p class="related-link"><a href={href}>{label}</a> &rarr;</p>
      ))}
    </section>

    <AdSlot slot="0099887766" />

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <dl class="faq-list">
        {copy.faqs.map(({ q, a }) => (
          <div class="faq-item">
            <dt class="faq-q">
              <button type="button" aria-expanded="false" class="faq-toggle">
                {fill(q)}
                <span class="faq-icon" aria-hidden="true">+</span>
              </button>
            </dt>
            <dd class="faq-a" hidden>
              <p>{fill(a)}</p>
            </dd>
          </div>
        ))}
      </dl>
    </section>

  </div>
</main>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      const dd = btn.closest('.faq-item')?.querySelector('.faq-a') as HTMLElement | null;
      const icon = btn.querySelector('.faq-icon');
      if (dd) dd.hidden = expanded;
      if (icon) icon.textContent = expanded ? '+' : '−';
    });
  });
</script>

<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: 860px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: 40px 0 80px;
  }

  .tool-header {
    margin-bottom: 20px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  .page-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--site-accent);
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text-muted);
    margin: 0;
    max-width: 64ch;
  }

  .direct-answer {
    border-left: 3px solid var(--site-accent);
    padding: 4px 0 4px 16px;
    margin-bottom: 24px;
  }

  .answer-main {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--site-text);
    margin: 0 0 4px;
  }

  .answer-alt {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--site-text-muted);
    margin: 0;
  }

  .tool-area {
    margin-bottom: 32px;
  }

  .table-section,
  .content-section,
  .faq-section {
    margin: 40px 0;
  }

  .table-section h2,
  .content-section h2,
  .faq-section h2 {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .table-intro {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 16px;
    max-width: 72ch;
  }

  .table-card {
    background: var(--site-bg-card);
    border-radius: var(--radius-site-card);
    box-shadow: var(--shadow-site);
    padding: 12px 16px;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 10px 6px;
    border-bottom: 1px solid var(--site-border);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--site-text);
    word-break: break-word;
  }

  th {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--site-text-muted);
  }

  th:first-child,
  .food-cell {
    width: 32%;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  .cell-temp {
    display: block;
    font-weight: 600;
  }

  .cell-meta {
    display: block;
    font-size: 12px;
    color: var(--site-text-muted);
  }

  .capped-chip {
    display: inline-block;
    margin-top: 4px;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--site-accent);
    border: 1px solid var(--site-accent);
  }

  .table-footnote {
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-text-muted);
    margin: 10px 0 0;
    max-width: 72ch;
  }

  .content-section h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.18px;
    color: var(--site-text);
    margin: 28px 0 8px;
  }

  .content-section p {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 16px;
    max-width: 72ch;
  }

  .related-link {
    margin: 24px 0 0 !important;
  }

  .related-link a {
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
    font-weight: 600;
    color: var(--site-text);
  }

  .related-link a:hover {
    color: var(--site-accent);
  }

  .faq-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    border-radius: var(--radius-site-card);
    background: var(--site-bg-card);
    box-shadow: var(--shadow-site);
    overflow: hidden;
  }

  .faq-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    background: transparent;
    border: none;
    color: var(--site-text);
    font-family: var(--font-archivo);
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .faq-toggle:hover {
    background: var(--site-bg-hover);
  }

  .faq-icon {
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
    color: var(--site-text-muted);
  }

  .faq-a {
    margin: 0;
    padding: 0 20px 16px;
  }

  .faq-a p {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }
</style>
