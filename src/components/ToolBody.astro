---
import Faq from './Faq.astro';
import ConverterWidget from './ConverterWidget.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { LIVE_PAGES } from '../site.config';
import { flagshipCopy } from '../lib/flagship-copy';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale).tool;
const reverseLive = LIVE_PAGES.has('/air-fryer-to-oven');
const convectionLive = LIVE_PAGES.has('/convection-to-air-fryer');
const frozenLive = LIVE_PAGES.has('/frozen');
const copy = flagshipCopy(locale);
---

<main class="page-main">
  <div class="wrap">

    <Breadcrumb locale={locale} translatedSlug="/oven-to-air-fryer" />

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <h1>{dict.heading}</h1>
      <p class="tool-desc">{copy.subDesc}</p>
    </header>

    <section class="tool-area" aria-label="Converter">
      <ConverterWidget locale={locale} />
    </section>

    <AdSlot slot="1234567890" />

    <section class="content-section">
      <h2>{dict.aboutHeading}</h2>
      <p>{copy.aboutBody}</p>

      <h3>{dict.multipliersHeading}</h3>
      <p>{copy.multipliersBody}</p>

      <h3>{dict.basketVsOvenHeading}</h3>
      <p>{copy.basketVsOvenBody}</p>

      <h3>{dict.whatHappensHeading}</h3>
      <p>{copy.whatHappensBody}</p>

      <div class="related-links">
        <a href={localizedPath(locale, '/chart')} class="related-link">
          <div class="related-link-content">
            <span class="related-link-title">{dict.relatedChartLink}</span>
          </div>
          <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
        </a>
        {reverseLive && (
          <a href={localizedPath(locale, '/air-fryer-to-oven')} class="related-link">
            <div class="related-link-content">
              <span class="related-link-title">{dict.relatedReverseLink}</span>
            </div>
            <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        )}
        {convectionLive && (
          <a href={localizedPath(locale, '/convection-to-air-fryer')} class="related-link">
            <div class="related-link-content">
              <span class="related-link-title">{dict.relatedConvectionLink}</span>
            </div>
            <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        )}
        {frozenLive && (
          <a href={localizedPath(locale, '/frozen')} class="related-link">
            <div class="related-link-content">
              <span class="related-link-title">{dict.relatedFrozenLink}</span>
            </div>
            <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
    </section>

    <AdSlot slot="0987654321" />

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <Faq items={copy.faqs} />
    </section>

  </div>
</main>


<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: var(--site-content-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: var(--site-section-gap) 0;
  }

  .tool-header {
    margin-bottom: 28px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-archivo);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-family: var(--font-archivo);
    font-size: var(--text-lead);
    line-height: var(--text-body--line-height);
    letter-spacing: 0;
    color: var(--site-text-body);
    margin: 0;
    max-width: 68ch;
  }

  .tool-area {
    margin-bottom: 28px;
  }

  .content-section,
  .faq-section {
    margin: var(--site-section-gap) 0;
  }

  .content-section h2,
  .faq-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .content-section h3 {
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin: 32px 0 8px;
  }

  .content-section p {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-body);
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .related-links {
    margin: 32px 0;
  }

  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--site-rule);
    color: var(--site-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .related-link:first-child {
    border-top: none;
    padding-top: 0;
  }

  .related-link:hover {
    color: var(--site-text);
  }

  .related-link-content {
    flex: 1;
    min-width: 0;
  }

  .related-link-title {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin-bottom: 4px;
  }

  .related-link-desc {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }

  .related-link-arrow {
    color: var(--site-text-muted);
    flex-shrink: 0;
    font-size: 18px;
  }
</style>
