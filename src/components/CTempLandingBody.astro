---
import Faq from './Faq.astro';
import ConverterWidget from './ConverterWidget.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, OVEN_MARK_SCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { ovenMarkFor } from '../lib/converter';
import {
  fillPlaceholders,
  C_TEMP_LANDINGS,
  cTempLandingNeighbours,
  cTempLandingRows,
  cTempLandingSlug,
  cTempLandingValues,
  type CTempLanding,
  type CTempLandingC,
  type CTempLandingRow,
} from '../lib/temp-landings';
import { LIVE_PAGES } from '../site.config';

interface Props {
  locale?: LocaleCode;
  landing: CTempLanding;
}

const { locale = DEFAULT_LOCALE, landing } = Astro.props;
const all = getDictionary(locale);
const dict = all.cTempLanding;
const copy = dict.pages[landing.tempC as CTempLandingC];
const values = cTempLandingValues(landing, locale);
const fill = (text: string) => fillPlaceholders(text, values);

const rows = cTempLandingRows(landing.tempC);
const generalConvCapped = rows.find((r) => r.food === 'general')!.conv.basket.capped;
const generalFanCapped = rows.find((r) => r.food === 'general')!.fan.basket.capped;
const answerConv = fill(generalConvCapped ? dict.answerCappedTemplate : dict.answerTemplate);
const answerFan = fill(generalFanCapped ? dict.answerFanCappedTemplate : dict.answerFanTemplate);
const anyConvCapped = rows.some((r) => r.conv.basket.capped || r.conv.oven.capped);
const anyFanCapped = rows.some((r) => r.fan.basket.capped || r.fan.oven.capped);

const markScale = OVEN_MARK_SCALE[locale];

const convCell = (r: CTempLandingRow['conv']['basket']) => {
  const mark = ovenMarkFor(r.outF, markScale);
  return {
    temp: `${r.outF}°F / ${r.outC}°C`,
    meta: [mark ? `${all.converter.gasMark} ${mark}` : null, fillPlaceholders(dict.timeLessTemplate, { PCT: String(r.pct) })]
      .filter(Boolean)
      .join(' · '),
    capped: r.capped,
  };
};

const fanCell = (r: CTempLandingRow['fan']['basket']) => {
  const mark = ovenMarkFor(r.outF, markScale);
  return {
    temp: `${r.outF}°F / ${r.outC}°C`,
    meta: [mark ? `${all.converter.gasMark} ${mark}` : null, fillPlaceholders(dict.timeLessTemplate, { PCT: String(r.pct) })]
      .filter(Boolean)
      .join(' · '),
    capped: r.capped,
  };
};

const tableRows = rows.map((r) => ({
  food: r.food,
  label: all.converter.foods[r.food].label,
  convBasket: convCell(r.conv.basket),
  convOven: convCell(r.conv.oven),
  fanBasket: fanCell(r.fan.basket),
  fanOven: fanCell(r.fan.oven),
}));

const { prev, next } = cTempLandingNeighbours(landing.tempC);
const neighbourLinks = [prev, next]
  .filter((l): l is CTempLanding => l !== null && LIVE_PAGES.has(cTempLandingSlug(l.tempC)))
  .map((l) => ({
    href: localizedPath(locale, cTempLandingSlug(l.tempC)),
    label: fillPlaceholders(dict.neighbourLinkTemplate, { OVEN_C: String(l.tempC) }),
  }));

const links = [
  { slug: '/oven-to-air-fryer', label: dict.relatedFlagshipLink },
  { slug: '/chart', label: dict.relatedChartLink },
  { slug: '/frozen', label: dict.relatedFrozenLink },
  { slug: '/convection-to-air-fryer', label: dict.relatedConvectionLink },
]
  .filter(({ slug }) => LIVE_PAGES.has(slug))
  .map(({ slug, label }) => ({ href: localizedPath(locale, slug), label }));

// Cross-link to nearest °F page
const nearestF = landing.nearestF;
const nearestFSlug = `/${nearestF}-to-air-fryer`;
const nearestFLive = LIVE_PAGES.has(nearestFSlug);
const nearestFHref = localizedPath(locale, nearestFSlug);
---

<main class="page-main">
  <div class="wrap">

    <Breadcrumb locale={locale} translatedSlug={cTempLandingSlug(landing.tempC)} />

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <p class="page-tag">{dict.pageTag}</p>
      <h1>{fill(copy.heading)}</h1>
      <p class="tool-desc">{fill(copy.subDesc)}</p>
    </header>

    <div class="direct-answer">
      <p id="ctl-answer" class="answer-main">{answerConv}</p>
      <p id="ctl-answer-fan" class="answer-alt">{answerFan}</p>
      <p id="ctl-answer-oven" class="answer-alt">{fill(dict.answerOvenStyleTemplate)}</p>
    </div>

    <section class="tool-area" aria-label="Converter">
      <div class="widget-intro">
        <h2>{copy.widgetHeading ? fill(copy.widgetHeading) : dict.widgetHeading}</h2>
        <p>{copy.widgetNote ? fill(copy.widgetNote) : fill(dict.widgetNote)}</p>
      </div>
      <ConverterWidget locale={locale} initialTemp={landing.tempC} initialUnit="C" />
    </section>

    <AdSlot slot="6677889900" />

    <section class="table-section">
      <h2>{fill(dict.tableHeading)}</h2>
      <p class="table-intro">{dict.tableIntro}</p>
      <div class="table-card">
        <table id="ctl-food-table">
          <thead>
            <tr>
              <th>{dict.tableHeaders.food}</th>
              <th colspan="2">{dict.tableHeaders.conventional}</th>
              <th colspan="2">{dict.tableHeaders.fan}</th>
            </tr>
            <tr>
              <th></th>
              <th>{dict.tableHeaders.basket}</th>
              <th>{dict.tableHeaders.ovenStyle}</th>
              <th>{dict.tableHeaders.basket}</th>
              <th>{dict.tableHeaders.ovenStyle}</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map((r) => (
              <tr data-food={r.food}>
                <td class="food-cell">{r.label}</td>
                {[r.convBasket, r.convOven].map((c, i) => (
                  <td class:list={['result-cell', { capped: c.capped }]} data-style={i === 0 ? 'basket' : 'oven'}>
                    <span class="cell-temp">{c.temp}</span>
                    <span class="cell-meta">{c.meta}</span>
                    {c.capped && <span class="capped-chip">{dict.cappedCell}</span>}
                  </td>
                ))}
                {[r.fanBasket, r.fanOven].map((c, i) => (
                  <td class:list={['result-cell', { capped: c.capped }]} data-style={i === 0 ? 'basket' : 'oven'}>
                    <span class="cell-temp">{c.temp}</span>
                    <span class="cell-meta">{c.meta}</span>
                    {c.capped && <span class="capped-chip">{dict.cappedCell}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {(anyConvCapped || anyFanCapped) && (
        <p id="ctl-capped-footnote" class="table-footnote">{fill(dict.cappedFootnote)}</p>
      )}
    </section>

    <section class="content-section">
      <h2>{fill(copy.recipesHeading)}</h2>
      <p>{fill(copy.recipesBody)}</p>

      <h3>{fill(copy.failureHeading)}</h3>
      <p>{fill(copy.failureBody)}</p>

      <h3>{fill(copy.workedExampleHeading)}</h3>
      <p>{fill(copy.workedExampleTemplate)}</p>

      <h3>{fill(copy.fanWorkedExampleHeading)}</h3>
      <p>{fill(copy.fanWorkedExampleTemplate)}</p>

      <h3>{fill(copy.styleHeading)}</h3>
      <p>{fill(copy.styleBody)}</p>

      {neighbourLinks.length > 0 && (
        <>
          <h3>{dict.neighboursHeading}</h3>
          {neighbourLinks.map(({ href, label }) => (
            <p class="related-link neighbour-link"><a href={href}>{label}</a> &rarr;</p>
          ))}
        </>
      )}

      {nearestFLive && (
        <p class="related-link"><a href={nearestFHref}>{dict.relatedNearestFLink.replace('{F}', String(nearestF))}</a> &rarr;</p>
      )}

      {links.map(({ href, label }) => (
        <p class="related-link"><a href={href}>{label}</a> &rarr;</p>
      ))}
    </section>

    <AdSlot slot="0099887766" />

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <Faq items={copy.faqs.map(({ q, a }) => ({ q: fill(q), a: fill(a) }))} />
    </section>

  </div>
</main>


<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: var(--site-content-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: var(--site-section-gap) 0;
  }

  .tool-header {
    margin-bottom: 28px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-archivo);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  .page-tag {
    font-family: var(--font-archivo);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin: 0 0 12px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-family: var(--font-archivo);
    font-size: var(--text-lead);
    line-height: var(--text-body--line-height);
    letter-spacing: 0;
    color: var(--site-text-body);
    margin: 0;
    max-width: 68ch;
  }

  .direct-answer {
    background: var(--site-bg-card);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    margin-bottom: 24px;
  }

  .answer-main {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--site-text);
    margin: 0 0 4px;
  }

  .answer-alt {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 4px;
  }

  .tool-area {
    margin-bottom: 28px;
  }

  .widget-intro {
    margin-bottom: 16px;
  }
  .widget-intro h2 {
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin: 0 0 8px;
  }
  .widget-intro p {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0;
  }

  .table-section,
  .content-section,
  .faq-section {
    margin: var(--site-section-gap) 0;
  }

  .table-section h2,
  .content-section h2,
  .faq-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .table-intro {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-body);
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .table-card {
    background: var(--site-bg-card);
    border: 1px solid var(--site-hairline);
    border-radius: var(--radius-lg);
    padding: 0;
    overflow-x: auto;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 12px 16px;
    border-bottom: 1px solid var(--site-hairline);
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    color: var(--site-text);
    word-break: break-word;
  }

  th {
    background: var(--site-band);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--site-text-muted);
    border-bottom: 1px solid var(--site-rule);
  }

  th:first-child,
  .food-cell {
    width: 25%;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  .cell-temp {
    display: block;
    font-weight: 600;
  }

  .cell-meta {
    display: block;
    font-size: 12px;
    color: var(--site-text-muted);
  }

  .capped-chip {
    display: inline-block;
    margin-top: 4px;
    padding: 1px 6px;
    border-radius: var(--radius-md);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--site-text);
    background: var(--site-bg-deep);
    border: 1px solid var(--site-accent);
  }

  .table-footnote {
    font-family: var(--font-archivo);
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-text-muted);
    margin: 10px 0 0;
    max-width: 68ch;
  }

  .content-section h3 {
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin: 32px 0 8px;
  }

  .content-section p {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-body);
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .related-links {
    margin: 32px 0;
  }

  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--site-rule);
    color: var(--site-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .related-link:first-child {
    border-top: none;
    padding-top: 0;
  }

  .related-link:hover {
    color: var(--site-text);
  }

  .related-link-content {
    flex: 1;
    min-width: 0;
  }

  .related-link-title {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin-bottom: 4px;
  }

  .related-link-desc {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }

  .related-link-arrow {
    color: var(--site-text-muted);
    flex-shrink: 0;
    font-size: 18px;
  }

  .neighbour-link a {
    font-weight: 600;
    color: var(--site-accent-text);
    text-decoration: none;
  }

  .neighbour-link a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    th:first-child,
    .food-cell {
      width: 100%;
    }
    th:nth-child(n+2),
    td:nth-child(n+2) {
      display: none;
    }
  }

  @media print {
    .back-link,
    .tool-area,
    .page-tag,
    .chart-lead,
    .content-section,
    .faq-section,
    .related-links {
      display: none !important;
    }

    .wrap {
      max-width: 100%;
      padding: 0;
    }

    h1 {
      font-size: 16pt;
      margin: 0 0 6pt;
    }

    table {
      font-size: 10pt;
    }

    th, td {
      border: 1px solid #000;
      color: #000;
      padding: 2pt 4pt;
      font-size: 10pt;
    }
  }
</style>