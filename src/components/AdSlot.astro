---
import siteConfig from '../site.config.ts';

interface Props {
  slot: string;
  format?: string;
  layout?: string;
}

const { slot: adSlot, format = 'auto', layout } = Astro.props;

// Placeholder IDs from the starter template; AdSense can never fill them.
const PLACEHOLDER_SLOTS = new Set(['1234567890', '0987654321', '2233445566', '4455667788', '6655443322']);

// Render nothing until AdSense is configured, units are switched on, and the slot is a real one
const show = Boolean(siteConfig.adsenseId) && siteConfig.adsReady && !PLACEHOLDER_SLOTS.has(adSlot);
---

{show && (
  <div class="ad-wrapper" aria-label="Advertisement">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={siteConfig.adsenseId}
      data-ad-slot={adSlot}
      data-ad-format={format}
      data-ad-layout={layout}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}

<style>
  .ad-wrapper {
    margin: 2rem 0;
    text-align: center;
  }
</style>
