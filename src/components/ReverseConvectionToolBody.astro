---
import Faq from './Faq.astro';
import ReverseConverterWidget from './ReverseConverterWidget.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { computeConvectionSetting } from '../lib/converter';
import { LIVE_PAGES } from '../site.config';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale).reverseConvectionTool;

const generalConv = computeConvectionSetting({ airFryerTemp: 340, unit: 'F', airFryerMinutes: 27, food: 'general', style: 'basket' });
const friesConv = computeConvectionSetting({ airFryerTemp: 390, unit: 'F', airFryerMinutes: 18, food: 'fries', style: 'basket' });

const workedExampleBody = dict.workedExampleTemplate
  .replace('{GENERAL_CONV_F}', String(generalConv.outF))
  .replace('{GENERAL_CONV_MIN}', String(generalConv.outMinutes))
  .replace('{FRIES_CONV_F}', String(friesConv.outF))
  .replace('{FRIES_CONV_MIN}', String(friesConv.outMinutes));

const links = [
  { slug: '/convection-to-air-fryer', label: dict.relatedSiblingLink },
  { slug: '/air-fryer-to-oven', label: dict.relatedReverseLink },
  { slug: '/oven-to-air-fryer', label: dict.relatedFlagshipLink },
  { slug: '/chart', label: dict.relatedChartLink },
  { slug: '/frozen', label: dict.relatedFrozenLink },
]
  .filter(({ slug }) => LIVE_PAGES.has(slug))
  .map(({ slug, label }) => ({ href: localizedPath(locale, slug), label }));
---

<main class="page-main">
  <div class="wrap">

    <Breadcrumb locale={locale} translatedSlug="/air-fryer-to-convection" />

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <h1>{dict.heading}</h1>
      <p class="tool-desc">{dict.subDesc}</p>
    </header>

    <section class="tool-area" aria-label="Converter">
      <ReverseConverterWidget locale={locale} target="convection" />
    </section>

    <AdSlot slot="4455667788" />

    <section class="content-section">
      <h2>{dict.aboutHeading}</h2>
      <p>{dict.aboutBody}</p>

      <h3>{dict.whenConvectionHeading}</h3>
      <p>{dict.whenConvectionBody}</p>

      <h3>{dict.roundingHeading}</h3>
      <p>{dict.roundingBody}</p>

      <h3>{dict.workedExampleHeading}</h3>
      <p>{workedExampleBody}</p>

      <h3>{dict.ceilingHeading}</h3>
      <p>{dict.ceilingBody}</p>

      <div class="related-links">
        {links.map(({ href, label }) => (
          <a href={href} class="related-link">
            <div class="related-link-content">
              <span class="related-link-title">{label}</span>
            </div>
            <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <AdSlot slot="8877665544" />

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <Faq items={dict.faqs} />
    </section>

  </div>
</main>


<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: var(--site-content-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: var(--site-section-gap) 0;
  }

  .tool-header {
    margin-bottom: 28px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-archivo);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-family: var(--font-archivo);
    font-size: var(--text-lead);
    line-height: var(--text-body--line-height);
    letter-spacing: 0;
    color: var(--site-text-body);
    margin: 0;
    max-width: 68ch;
  }

  .tool-area {
    margin-bottom: 28px;
  }

  .content-section,
  .faq-section {
    margin: var(--site-section-gap) 0;
  }

  .content-section h2,
  .faq-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .content-section h3 {
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin: 32px 0 8px;
  }

  .content-section p {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-body);
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .related-links {
    margin: 32px 0;
  }

  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--site-rule);
    color: var(--site-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .related-link:first-child {
    border-top: none;
    padding-top: 0;
  }

  .related-link:hover {
    color: var(--site-text);
  }

  .related-link-content {
    flex: 1;
    min-width: 0;
  }

  .related-link-title {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin-bottom: 4px;
  }

  .related-link-desc {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }

  .related-link-arrow {
    color: var(--site-text-muted);
    flex-shrink: 0;
    font-size: 18px;
  }
</style>
