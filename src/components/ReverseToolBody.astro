---
import Faq from './Faq.astro';
import ReverseConverterWidget from './ReverseConverterWidget.astro';
import AdSlot from './AdSlot.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { computeOvenSetting } from '../lib/converter';
import { LIVE_PAGES } from '../site.config';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale).reverseTool;

const generalOven = computeOvenSetting({ airFryerTemp: 375, unit: 'F', airFryerMinutes: 20, food: 'general', style: 'basket' });
const friesOven = computeOvenSetting({ airFryerTemp: 400, unit: 'F', airFryerMinutes: 12, food: 'fries', style: 'basket' });

const workedExampleBody = dict.workedExampleTemplate
  .replace('{GENERAL_OVEN_F}', String(generalOven.outF))
  .replace('{GENERAL_OVEN_MIN}', String(generalOven.outMinutes))
  .replace('{FRIES_OVEN_F}', String(friesOven.outF))
  .replace('{FRIES_OVEN_MIN}', String(friesOven.outMinutes));

const flagshipLive = LIVE_PAGES.has('/oven-to-air-fryer');
const chartLive = LIVE_PAGES.has('/chart');
const convectionLive = LIVE_PAGES.has('/air-fryer-to-convection');
const flagshipHref = localizedPath(locale, '/oven-to-air-fryer');
const chartHref = localizedPath(locale, '/chart');
---

<main class="page-main">
  <div class="wrap">

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <h1>{dict.heading}</h1>
      <p class="tool-desc">{dict.subDesc}</p>
    </header>

    <section class="tool-area" aria-label="Converter">
      <ReverseConverterWidget locale={locale} />
    </section>

    <AdSlot slot="2233445566" />

    <section class="content-section">
      <h2>{dict.aboutHeading}</h2>
      <p>{dict.aboutBody}</p>

      <h3>{dict.roundingHeading}</h3>
      <p>{dict.roundingBody}</p>

      <h3>{dict.workedExampleHeading}</h3>
      <p>{workedExampleBody}</p>

      <h3>{dict.whenOvenBetterHeading}</h3>
      <p>{dict.whenOvenBetterBody}</p>

      <h3>{dict.ovenCaveatHeading}</h3>
      <p>{dict.ovenCaveatBody}</p>

      {flagshipLive && (
        <p class="related-link"><a href={flagshipHref}>{dict.relatedFlagshipLink}</a> &rarr;</p>
      )}
      {chartLive && (
        <p class="related-link"><a href={chartHref}>{dict.relatedChartLink}</a> &rarr;</p>
      )}
      {convectionLive && (
        <p class="related-link"><a href={localizedPath(locale, '/air-fryer-to-convection')}>{dict.relatedConvectionLink}</a> &rarr;</p>
      )}
    </section>

    <AdSlot slot="6655443322" />

    <section class="faq-section">
      <h2>{dict.faqHeading}</h2>
      <Faq items={dict.faqs} />
    </section>

  </div>
</main>


<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: 860px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: 40px 0 80px;
  }

  .tool-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text-muted);
    margin: 0;
    max-width: 64ch;
  }

  .tool-area {
    margin-bottom: 32px;
  }

  .content-section,
  .faq-section {
    margin: 40px 0;
  }

  .content-section h2,
  .faq-section h2 {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .content-section h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.18px;
    color: var(--site-text);
    margin: 28px 0 8px;
  }

  .content-section p {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 16px;
    max-width: 72ch;
  }

  .related-link {
    margin: 24px 0 0 !important;
  }

  .related-link a {
    font-weight: 600;
    color: var(--site-text);
  }

  .related-link a:hover {
    color: var(--site-accent);
  }







</style>
