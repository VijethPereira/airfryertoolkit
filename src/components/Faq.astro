---
/**
 * FAQ list as <details>/<summary>: answers open without JS and are in the server HTML.
 * Pass the text already filled; the caller's FAQPage JSON-LD must use the same strings.
 */
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map(({ q, a }) => (
    <details class="faq-item">
      <summary class="faq-q">{q}<span class="faq-icon" aria-hidden="true"></span></summary>
      <div class="faq-a"><p>{a}</p></div>
    </details>
  ))}
</div>

<style>
  @reference '../styles/global.css';

  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { border-radius: var(--radius-site-card); background: var(--site-bg-card); box-shadow: var(--shadow-site); overflow: hidden; }
  .faq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 44px; padding: 16px 20px; cursor: pointer; list-style: none;
    font-family: var(--font-archivo); font-size: 15px; font-weight: 600; color: var(--site-text);
    transition: background 0.15s ease;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { background: var(--site-bg-hover); }
  .faq-icon { flex-shrink: 0; }
  .faq-icon::before { content: '+'; font-size: 20px; line-height: 1; color: var(--site-text-muted); }
  details[open] .faq-icon::before { content: '\2212'; }
  .faq-a { padding: 0 20px 16px; }
  .faq-a p {
    margin: 0; font-size: var(--text-body); line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing); color: var(--site-text-muted);
  }

  /* Answers print expanded: a closed <details> hides its content in ::details-content. */
  @media print {
    .faq-item { box-shadow: none; border: 1px solid var(--site-border); break-inside: avoid; }
    .faq-item::details-content { content-visibility: visible; display: block; }
    .faq-icon { display: none; }
  }
</style>
