---
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';
import { PRESETS } from '../data/presets';
import { PRESET_CATEGORY_ORDER, presetCard } from '../lib/presets';
import { LIVE_PAGES } from '../site.config';
import type { FoodPreset } from '../data/presets';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const all = getDictionary(locale);
const dict = all.presetsIndex;

// Generated from PRESETS: one group per category that has at least one preset, in PRESET_CATEGORY_ORDER.
const categoryGroups = PRESET_CATEGORY_ORDER.map((category) => ({
  category,
  heading: dict.categories[category],
  cards: PRESETS.filter((p) => p.category === category)
    .map((p) => presetCard(p, locale))
    .filter((c) => LIVE_PAGES.has(c.path)),
})).filter((g) => g.cards.length > 0);

// Holiday group: shows first while any holiday preset is live.
const holidayCards = PRESETS.filter((p: FoodPreset) => p.seasonal === 'holiday')
  .map((p) => presetCard(p, locale))
  .filter((c) => LIVE_PAGES.has(c.path));
const holidayGroup = holidayCards.length > 0
  ? { category: 'holiday', heading: all.presetsIndex.holidayGroupHeading, cards: holidayCards }
  : null;

const groups = holidayGroup ? [holidayGroup, ...categoryGroups] : categoryGroups;

const links = [
  { slug: '/oven-to-air-fryer', label: dict.relatedFlagshipLink },
  { slug: '/chart', label: dict.relatedChartLink },
]
  .filter(({ slug }) => LIVE_PAGES.has(slug))
  .map(({ slug, label }) => ({ href: localizedPath(locale, slug), label }));
---

<main class="page-main">
  <div class="wrap">

    <Breadcrumb locale={locale} translatedSlug="/presets" />

    <header class="tool-header">
      <a href={localizedPath(locale, '/')} class="back-link" aria-label={dict.backLink}>&larr; {dict.backLink}</a>
      <h1>{dict.heading}</h1>
      <p class="tool-desc">{dict.intro}</p>
    </header>

    {groups.map((g) => (
      <section class="group" data-category={g.category}>
        <h2>{g.heading}</h2>
        <div class="card-grid">
          {g.cards.map((c) => (
            <a href={c.href} class="card" data-slug={c.slug}>
              <span class="card-title">{c.label}</span>
              <span class="card-spec">{c.spec}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <AdSlot slot="2211009988" />

    <section class="content-section">
      <h2>{dict.howHeading}</h2>
      <p>{dict.howBody}</p>
      <div class="related-links">
        {links.map(({ href, label }) => (
          <a href={href} class="related-link">
            <div class="related-link-content">
              <span class="related-link-title">{label}</span>
            </div>
            <span class="related-link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</main>

<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: var(--site-content-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .page-main {
    padding: var(--site-section-gap) 0;
  }

  .tool-header {
    margin-bottom: 28px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-archivo);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-caption--letter-spacing);
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--site-text);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--site-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tool-desc {
    font-family: var(--font-archivo);
    font-size: var(--text-lead);
    line-height: var(--text-body--line-height);
    letter-spacing: 0;
    color: var(--site-text-body);
    margin: 0;
    max-width: 68ch;
  }

  .group {
    margin: var(--site-section-gap) 0;
  }

  .group h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 44px;
    padding: 24px 28px;
    border-radius: var(--radius-lg);
    background: var(--site-bg-card);
    border: 1px solid var(--site-hairline);
    color: var(--site-text);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    background: var(--site-bg-hover);
    border-color: var(--site-rule);
    color: var(--site-text);
  }

  .card-title {
    font-family: var(--font-archivo);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .card-spec {
    font-family: var(--font-archivo);
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--site-text);
    margin-bottom: 6px;
  }

  .card-desc {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }

  .content-section {
    margin: var(--site-section-gap) 0;
  }

  .content-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--site-text);
    margin: 0 0 16px;
  }

  .content-section p {
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-body);
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .related-links {
    margin: 32px 0;
  }

  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--site-rule);
    color: var(--site-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .related-link:first-child {
    border-top: none;
    padding-top: 0;
  }

  .related-link:hover {
    color: var(--site-text);
  }

  .related-link-content {
    flex: 1;
    min-width: 0;
  }

  .related-link-title {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-subheading);
    font-weight: 600;
    letter-spacing: var(--text-subheading--letter-spacing);
    color: var(--site-text);
    margin-bottom: 4px;
  }

  .related-link-desc {
    display: block;
    font-family: var(--font-archivo);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
  }

  .related-link-arrow {
    color: var(--site-text-muted);
    flex-shrink: 0;
    font-size: 18px;
  }
</style>
