---
import siteConfig from '../site.config.ts';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.siteName} home`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span>{siteConfig.siteName}</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="nav-links">
        {siteConfig.navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  @reference '../styles/global.css';

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 200;
    height: 64px;
    background: var(--site-nav-bg);
    box-shadow: var(--shadow-site);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.45px;
    color: var(--site-text);
    margin-right: auto;
    flex-shrink: 0;
  }

  .brand:hover {
    color: var(--site-text);
  }

  .logo-mark {
    display: block;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--site-text);
    border-radius: 4px;
    background: linear-gradient(var(--site-accent) 0 45%, transparent 45%);
  }

  nav {
    flex: 1;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }

  .nav-link {
    display: block;
    padding: 0 12px;
    line-height: 32px;
    font-size: 14px;
    color: var(--site-text);
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--site-text-muted);
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
  }
</style>
