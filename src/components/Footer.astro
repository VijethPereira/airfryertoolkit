---
import siteConfig from '../site.config.ts';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale).footer;

/** `translated: true` links point at the 2 pages this launch translates (home + tool page) and get a locale prefix; the rest stay English-only. */
const footerLinks = [
  { label: dict.converter, href: '/oven-to-air-fryer', translated: true },
  { label: dict.foodPresets, href: '/#presets', translated: true },
  { label: dict.conversionChart, href: '/#chart', translated: true },
  { label: dict.about, href: '/about', translated: false },
  { label: dict.contact, href: '/contact', translated: false },
  { label: dict.privacyPolicy, href: '/privacy-policy', translated: false },
  { label: dict.termsConditions, href: '/terms', translated: false },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-brand">{siteConfig.siteName}</p>

    <nav aria-label="Footer navigation">
      <ul class="footer-links">
        {footerLinks.map((link) => (
          <li><a href={link.translated ? localizedPath(locale, link.href) : link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="sister-pill">
      <span>{dict.moreFreeTools}</span>
      {siteConfig.sisterSites.map((site, i) => (
        <>
          {i > 0 && <span class="sep">&middot;</span>}
          <a href={site.href} title={site.title} target="_blank" rel="noopener noreferrer">{site.label}</a>
        </>
      ))}
    </div>

    <p class="copyright">&copy; 2026 {siteConfig.siteName} — {dict.copyrightSuffix}</p>
  </div>
</footer>

<style>
  @reference '../styles/global.css';

  .site-footer {
    background: var(--site-bg-deep);
    border-top: 1px solid var(--site-border);
    padding: 64px 0;
  }

  .footer-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-brand {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.45px;
    color: var(--site-text);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }

  .footer-links a {
    font-size: 14px;
    color: var(--site-text);
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--site-text-muted);
  }

  .sister-pill {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 6px 16px;
    background: var(--site-bg);
    border-radius: 999px;
    font-size: 13px;
  }

  .sister-pill > span:first-child {
    color: var(--site-text-muted);
  }

  .sister-pill a {
    color: var(--site-text);
    font-weight: 600;
  }

  .sep {
    color: var(--site-border);
  }

  .copyright {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.66px;
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin: 0;
  }
</style>
