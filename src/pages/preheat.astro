---
// /preheat (row 15). Rendered on request so the per-model table's sorting and filtering are plain links
// (?brand=&kind=&sort=) that work without JavaScript; every variant canonicals to the bare URL. The tool's
// own state (?temp=&unit=&style=&model=) is read in the browser. Same body and table in all 5 locales.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import PreheatBody from '../components/PreheatBody.astro';
import PreheatModelsTable from '../components/PreheatModelsTable.astro';
import { getDictionary } from '../i18n/dictionaries';
import { localizedUrl } from '../i18n/utils';
import { PREHEAT_PATH } from '../lib/preheat';
import { preheatJsonLd } from '../lib/preheat-jsonld';

const locale = 'en' as const;
const dict = getDictionary(locale).preheat;
---

<Layout
  title={dict.metaTitle}
  description={dict.metaDescription}
  canonical={localizedUrl(locale, PREHEAT_PATH)}
  keywords={dict.metaKeywords}
  jsonLd={preheatJsonLd(locale)}
  locale={locale}
  translatedSlug={PREHEAT_PATH}
>
  <SiteNav currentPath={PREHEAT_PATH} locale={locale} translatedSlug={PREHEAT_PATH} />
  <PreheatBody locale={locale}>
    <PreheatModelsTable locale={locale} />
  </PreheatBody>
  <Footer locale={locale} />
</Layout>
