---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import PresetBody from '../../components/PresetBody.astro';
import siteConfig from '../../site.config.ts';
import { localizedUrl } from '../../i18n/utils';
import { PRESETS, type FoodPreset } from '../../data/presets';
import { presetCopy, presetPath } from '../../lib/presets';

export function getStaticPaths() {
  return PRESETS.map((preset) => ({ params: { food: preset.slug }, props: { preset } }));
}

const { preset } = Astro.props as { preset: FoodPreset };
const locale = 'en' as const;
const { copy, fill } = presetCopy(preset, locale);
const slug = presetPath(preset.slug);
const url = localizedUrl(locale, slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${url}#app`,
      name: `${fill(copy.heading)} — ${siteConfig.siteName}`,
      description: fill(copy.metaDescription),
      url,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: copy.faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: fill(q),
        acceptedAnswer: { '@type': 'Answer', text: fill(a) },
      })),
    },
  ],
};
---

<Layout
  title={fill(copy.metaTitle)}
  description={fill(copy.metaDescription)}
  canonical={url}
  keywords={copy.metaKeywords}
  jsonLd={jsonLd}
  locale={locale}
  translatedSlug={slug}
>
  <SiteNav currentPath={slug} locale={locale} translatedSlug={slug} />
  <PresetBody locale={locale} preset={preset} />
  <Footer locale={locale} />
</Layout>
