---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import PreheatBody from '../../components/PreheatBody.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { localizedUrl } from '../../i18n/utils';
import { PREHEAT_PATH } from '../../lib/preheat';
import { preheatJsonLd } from '../../lib/preheat-jsonld';

const locale = 'pt' as const;
const dict = getDictionary(locale).preheat;
---

<Layout
  title={dict.metaTitle}
  description={dict.metaDescription}
  canonical={localizedUrl(locale, PREHEAT_PATH)}
  keywords={dict.metaKeywords}
  jsonLd={preheatJsonLd(locale)}
  locale={locale}
  translatedSlug={PREHEAT_PATH}
>
  <SiteNav currentPath={PREHEAT_PATH} locale={locale} translatedSlug={PREHEAT_PATH} />
  <PreheatBody locale={locale} />
  <Footer locale={locale} />
</Layout>
