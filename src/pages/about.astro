---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../site.config.ts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteConfig.domain}/about#page`,
      url: `${siteConfig.domain}/about`,
      name: `About ${siteConfig.siteName}`,
      description: `Learn how ${siteConfig.siteName} converts oven settings to air fryer settings using food-type multipliers and a ceiling clamp — not a flat 25° rule.`,
      isPartOf: { '@id': `${siteConfig.domain}/#website` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteConfig.domain}/#org`,
      name: siteConfig.siteName,
      url: siteConfig.domain,
      founder: {
        '@type': 'Person',
        name: 'Vijeth Pereira',
        url: 'https://vijeth-portfolio.pages.dev/',
      },
    },
  ],
};
---

<Layout
  title="About"
  description={`Learn how ${siteConfig.siteName} converts oven settings to air fryer settings using food-type multipliers and a ceiling clamp, why the flat 25°F rule falls short, and who built it.`}
  canonical={`${siteConfig.domain}/about`}
  keywords="about air fryer toolkit, oven to air fryer conversion, air fryer conversion calculator"
  jsonLd={jsonLd}
>
  <SiteNav currentPath="/about" />

  <main class="page-main">
    <div class="page-container">

      <div class="page-header">
        <div class="page-tag">About</div>
        <h1>About {siteConfig.siteName}</h1>
        <p class="page-lead">
          A free, browser-based tool for converting oven recipes to air fryer settings — adjusted
          for what you're actually cooking, not a single flat rule.
        </p>
      </div>

      <div class="prose">

        <h2>What Is {siteConfig.siteName}?</h2>
        <p>
          {siteConfig.siteName} is a free oven-to-air-fryer conversion calculator. Enter the
          temperature and time from any recipe and get back the matching air fryer setting — and
          the reverse, if you want to go from an air fryer setting back to a conventional oven.
          The tool runs entirely in your browser: nothing is installed, no account is required, and
          the calculation never touches a server.
        </p>

        <h2>Why We Built It</h2>
        <p>
          The advice you'll find most places is a flat rule: "subtract 25°F and cut the time by
          20%." That rule is a reasonable average, but it treats fries, chicken breast, and a frozen
          casserole identically — and it doesn't distinguish between a basket-style air fryer and an
          oven-style one, which circulate air differently and top out at different temperatures.
        </p>
        <p>
          {siteConfig.siteName} replaces the flat rule with per-food adjustments and a hardware
          ceiling, so the number you get back is one your appliance can actually reach.
        </p>

        <h2>How the Conversion Works</h2>
        <p>
          Every food type in the converter carries its own temperature offset and time multiplier,
          tuned from how that food actually behaves in an air fryer:
        </p>
        <ul>
          <li><strong>Food-type adjustment</strong> — fries, wings, chicken breast, steak, fish, bacon, vegetables, baked goods, pizza, and casseroles each use a different temperature offset and time multiplier, instead of one number for everything.</li>
          <li><strong>Basket vs. oven-style</strong> — basket-style air fryers and oven-style (convection toaster oven) units circulate air differently, so the offset and multiplier shift slightly depending on which one you select.</li>
          <li><strong>Ceiling clamp</strong> — basket-style units are capped at 400°F and oven-style units at 450°F, matching real hardware limits. If a recipe would convert above that, the result is held at the ceiling and time is added back rather than suggesting a setting your unit can't reach.</li>
          <li><strong>Gas mark &amp; check-in time</strong> — results also show the nearest UK gas mark and a suggested check-in point at roughly 70% of the cook time, so you can catch food before it's overdone.</li>
        </ul>

        <h2>Who Uses {siteConfig.siteName}?</h2>
        <p>
          Home cooks converting a favorite oven recipe for the first time, air fryer beginners who
          only have the oven instructions on a box, and anyone meal-prepping who wants a faster
          appliance without guessing at the settings.
        </p>

        <h2>What's Coming Next</h2>
        <p>
          More food presets and brand-specific notes are in progress. If there's a food type,
          appliance brand, or feature you'd like to see, <a href="/contact">get in touch</a> — we
          read every message.
        </p>

        <h2>Who Made This?</h2>
        <p>
          {siteConfig.siteName} is designed and built by <strong>Vijeth Pereira</strong>, an
          independent developer focused on building fast, free, single-purpose web tools. You can
          learn more at <a href="https://vijeth-portfolio.pages.dev/" target="_blank" rel="noopener noreferrer">vijeth-portfolio.pages.dev</a>.
          {siteConfig.siteName} is part of a small family of free browser-based tools: <a href="https://quickmeasuretool.com" title="Quick Measure Tool — free online unit and measurement converter" target="_blank" rel="noopener noreferrer">Quick Measure Tool</a> for unit and measurement conversions, and <a href="https://snapimagetools.com" title="Snap Image Tools — free online image editing, resize, and compression" target="_blank" rel="noopener noreferrer">Snap Image Tools</a> for free online image editing, resizing, and compression.
        </p>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
