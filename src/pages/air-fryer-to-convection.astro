---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import ReverseConvectionToolBody from '../components/ReverseConvectionToolBody.astro';
import siteConfig from '../site.config.ts';
import { getDictionary } from '../i18n/dictionaries';

const locale = 'en' as const;
const dict = getDictionary(locale).reverseConvectionTool;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteConfig.domain}/air-fryer-to-convection#app`,
      name: `${dict.heading} — ${siteConfig.siteName}`,
      description: dict.metaDescription,
      url: `${siteConfig.domain}/air-fryer-to-convection`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: dict.faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Layout
  title={dict.metaTitle}
  description={dict.metaDescription}
  canonical={`${siteConfig.domain}/air-fryer-to-convection`}
  keywords={dict.metaKeywords}
  jsonLd={jsonLd}
  locale={locale}
  translatedSlug="/air-fryer-to-convection"
>
  <SiteNav currentPath="/air-fryer-to-convection" locale={locale} translatedSlug="/air-fryer-to-convection" />
  <ReverseConvectionToolBody locale={locale} />
  <Footer locale={locale} />
</Layout>
