---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import ChartBody from '../../components/ChartBody.astro';
import siteConfig from '../../site.config.ts';
import { getDictionary } from '../../i18n/dictionaries';
import { localizedUrl } from '../../i18n/utils';

const locale = 'de' as const;
const dict = getDictionary(locale).chart;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${localizedUrl(locale, '/chart')}#app`,
      name: `${dict.metaTitle} — ${siteConfig.siteName}`,
      description: dict.metaDescription,
      url: localizedUrl(locale, '/chart'),
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: dict.faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Layout
  title={dict.metaTitle}
  description={dict.metaDescription}
  canonical={localizedUrl(locale, '/chart')}
  keywords={dict.metaKeywords}
  jsonLd={jsonLd}
  locale={locale}
  translatedSlug="/chart"
>
  <SiteNav currentPath="/chart" locale={locale} translatedSlug="/chart" />
  <ChartBody locale={locale} />
  <Footer locale={locale} />
</Layout>
