---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../site.config.ts';
---

<Layout
  title="Contact"
  description={`Get in touch with ${siteConfig.siteName}.`}
  canonical={`${siteConfig.domain}/contact`}
>
  <SiteNav currentPath="/contact" />

  <main class="page-main">
    <div class="wrap">
      <h1>Contact</h1>
      <p>
        Found a conversion that doesn't look right, or have a food type or brand you'd like added?
        Email <a href="mailto:hello@airfryertoolkit.com">hello@airfryertoolkit.com</a> — reports on
        specific settings are the most useful, since they help tune the underlying multipliers.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference '../styles/global.css';

  .page-main {
    padding: 48px 0 96px;
  }

  .wrap {
    max-width: 720px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  h1 {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--site-text);
    margin: 0 0 20px;
  }

  p {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--site-text-muted);
    margin: 0 0 16px;
    max-width: 65ch;
  }

  p a {
    color: var(--site-text);
    font-weight: 600;
  }
</style>
