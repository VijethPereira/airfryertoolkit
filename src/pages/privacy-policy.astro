---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../site.config.ts';

const effectiveDate = 'August 18, 2026';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteConfig.domain}/privacy-policy#page`,
  url: `${siteConfig.domain}/privacy-policy`,
  name: `Privacy Policy — ${siteConfig.siteName}`,
  description: `Privacy policy for ${siteConfig.siteName}. Learn how we use Google Analytics, Google AdSense, and what data is stored in your browser.`,
  isPartOf: { '@id': `${siteConfig.domain}/#website` },
};
---

<Layout
  title="Privacy Policy"
  description={`Privacy policy for ${siteConfig.siteName}. Learn how we use Google Analytics, Google AdSense, and what data is stored locally in your browser.`}
  canonical={`${siteConfig.domain}/privacy-policy`}
  keywords="air fryer toolkit privacy policy, google adsense privacy, google analytics privacy"
  jsonLd={jsonLd}
>
  <SiteNav currentPath="/privacy-policy" />

  <main class="page-main">
    <div class="page-container">

      <div class="page-header">
        <div class="page-tag">Legal</div>
        <h1>Privacy Policy</h1>
        <p class="page-lead">
          {siteConfig.siteName} is built to work without collecting anything from you. This policy
          explains what data is collected, how it is used, and your choices.
        </p>
        <p class="page-effective-date">Effective date: {effectiveDate}</p>
      </div>

      <div class="prose">

        <h2>1. Information We Collect</h2>
        <p>
          {siteConfig.siteName} does <strong>not</strong> require you to create an account or
          provide any personal information to use the converter. We do not sell personal data.
          The temperature, time, food type, and air fryer style you enter are processed entirely
          in your browser and are never sent to a server.
        </p>

        <h2>2. Cookies</h2>
        <p>
          {siteConfig.siteName} does not set any cookies of its own. If we enable the services
          described below, they may set the following:
        </p>
        <ul>
          <li>
            <strong>Google Analytics cookies</strong> (<code>_ga</code>, <code>_gid</code>, <code>_ga_*</code>) —
            set by Google Analytics to distinguish users and sessions. Retained for up to 2 years.
            See <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.
          </li>
          <li>
            <strong>Google AdSense cookies</strong> — set by Google to serve relevant
            advertisements and measure ad performance. See
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.
          </li>
        </ul>
        <p>You can clear cookies at any time via your browser settings.</p>

        <h2>3. Analytics</h2>
        <p>
          {siteConfig.siteName} uses <strong>Google Analytics</strong> to understand aggregate
          usage patterns such as page views, popular tools, and device types. Google Analytics
          collects anonymised data including your approximate location (country/region), browser
          type, device type, and pages visited. No personally identifiable information is
          collected or stored by us through this service.
        </p>
        <p>
          Google's privacy policy applies:
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">policies.google.com/privacy</a>.
          You can opt out of Google Analytics tracking by installing the
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
        </p>

        <h2>4. Advertising</h2>
        <p>
          {siteConfig.siteName} may display advertisements through <strong>Google AdSense</strong>.
          Google AdSense and its partners use cookies and similar tracking technologies to serve
          ads based on your prior visits to this and other websites.
        </p>
        <p>
          You may opt out of personalised advertising by visiting
          <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>
          or <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">aboutads.info/choices</a>.
          Google's privacy policy applies:
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">policies.google.com/privacy</a>.
        </p>

        <h2>5. Contact Form</h2>
        <p>
          If you use the <a href="/contact">contact form</a>, the name, email address, subject,
          and message you submit are sent directly to us by email via Cloudflare's infrastructure
          and are not stored in a database. We use Cloudflare Turnstile to verify submissions are
          not automated; Turnstile does not use cookies to track you across sites. We retain
          contact messages only as long as necessary to respond.
        </p>

        <h2>6. Third-Party Services</h2>
        <ul>
          <li>
            <strong>Google Fonts</strong> — loads the typeface used on this site, resulting in a
            request to <code>fonts.googleapis.com</code> that may log your IP address.
          </li>
          <li>
            <strong>Cloudflare</strong> — hosts this site and processes contact form submissions.
            See <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare's Privacy Policy</a>.
          </li>
        </ul>

        <h2>7. Children's Privacy</h2>
        <p>
          {siteConfig.siteName} is a general-purpose cooking tool suitable for all ages. We do not
          knowingly collect any personally identifiable information from children under 13. Google
          AdSense may display non-personalised ads to users in regions where personalised
          advertising is restricted.
        </p>

        <h2>8. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. The effective date at the top of
          this page will reflect when the policy was last revised. Continued use of
          {siteConfig.siteName} after any changes constitutes your acceptance of the updated policy.
        </p>

        <h2>9. Contact</h2>
        <p>
          For privacy-related questions, please use the <a href="/contact">contact page</a>.
        </p>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
