---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import HomeBody from '../../components/HomeBody.astro';
import siteConfig from '../../site.config.ts';
import { getDictionary } from '../../i18n/dictionaries';
import { localizedUrl } from '../../i18n/utils';

const locale = 'fr' as const;
const dict = getDictionary(locale).home;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${localizedUrl(locale, '/')}#website`,
      url: localizedUrl(locale, '/'),
      name: siteConfig.siteName,
      description: dict.metaDescription,
    },
    {
      '@type': 'Organization',
      '@id': `${siteConfig.domain}/#organization`,
      name: siteConfig.siteName,
      url: siteConfig.domain,
    },
  ],
};
---

<Layout
  title={dict.metaTitle}
  description={dict.metaDescription}
  canonical={localizedUrl(locale, '/')}
  keywords={dict.metaKeywords}
  jsonLd={jsonLd}
  locale={locale}
  translatedSlug="/"
>
  <SiteNav currentPath="/" locale={locale} translatedSlug="/" />
  <HomeBody locale={locale} />
  <Footer locale={locale} />
</Layout>
