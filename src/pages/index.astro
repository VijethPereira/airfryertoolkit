---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.astro';
import siteConfig from '../site.config.ts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.domain}/#website`,
      url: siteConfig.domain,
      name: siteConfig.siteName,
      description: siteConfig.tagline,
    },
    {
      '@type': 'Organization',
      '@id': `${siteConfig.domain}/#organization`,
      name: siteConfig.siteName,
      url: siteConfig.domain,
    },
  ],
};

const commonConversions = [
  { href: '/350-to-air-fryer', from: '350°F', to: '325°F', note: '−20% time' },
  { href: '/375-to-air-fryer', from: '375°F', to: '350°F', note: '−20% time' },
  { href: '/400-to-air-fryer', from: '400°F', to: '375°F', note: '−20% time' },
  { href: '/425-to-air-fryer', from: '425°F', to: '400°F', note: 'basket ceiling' },
];

const convertCards = [
  { href: '/oven-to-air-fryer', title: 'Oven → Air Fryer', dot: true, desc: 'The flagship. Food-type multipliers, basket vs. oven-style, max-temp ceiling, °F/°C/gas mark.' },
  { href: '/convection-to-air-fryer', title: 'Convection → Air Fryer', desc: 'Convection recipes are already fan-adjusted, so they need a gentler cut. Most tools get this wrong.' },
  { href: '/batch-scaler', title: 'Batch & serving scaler', desc: 'Adjust time when the basket is crowded or you are cooking in two loads.' },
  { href: '/wattage-adjustment', title: 'Wattage adjustment', desc: 'Compact 1,200 W baskets run slower than 1,700 W models. Correct for yours.' },
];

const reverseCards = [
  { href: '/air-fryer-to-oven', title: 'Air Fryer → Oven', desc: 'Cooking for a crowd, or the basket is busy. Go back the other way.' },
  { href: '/air-fryer-to-convection', title: 'Air Fryer → Convection', desc: 'Same fan principle, larger cavity. Adds back time, not temperature.' },
  { href: '/fahrenheit-celsius-gas-mark', title: '°F / °C / gas mark', desc: 'Straight temperature conversion for UK, EU, and US recipes.' },
  { href: '/#chart', title: 'Printable conversion chart', desc: 'Full °F and °C table for the fridge door. One page, no email, no ads.' },
];

const frozenCards = [
  { href: '/frozen-fries', title: 'Frozen fries', spec: '400°F · 15 min · shake ×2', desc: 'Single layer, no oil needed.' },
  { href: '/frozen-chicken-nuggets', title: 'Frozen nuggets', spec: '380°F · 10 min · flip once', desc: 'Breaded coating browns fast.' },
  { href: '/frozen-chicken', title: 'Frozen chicken breast', spec: '360°F · 22 min · 165°F core', desc: 'Lower and slower than you expect.' },
  { href: '/frozen-pizza', title: 'Frozen pizza', spec: '375°F · 8 min · no preheat', desc: 'Personal size only in a basket.' },
];

const presetCards = [
  { href: '/chicken-breast', title: 'Chicken breast', spec: '375°F · 16 min · flip at 8', desc: 'Highest-volume preset. Pull at 165°F internal.' },
  { href: '/chicken-wings', title: 'Chicken wings', spec: '400°F · 22 min · flip at 12', desc: 'Pat dry first. Two-stage temp option.' },
  { href: '/salmon', title: 'Salmon fillet', spec: '390°F · 9 min · no flip', desc: 'Skin down. Thickness table included.' },
  { href: '/bacon', title: 'Bacon', spec: '350°F · 9 min · drain at 5', desc: 'Lower temp stops the fat smoking.' },
];

const brandCards = [
  { href: '/ninja', title: 'Ninja', spec: 'Max 400°F · basket & dual', desc: 'AF101, AF161, DZ201 and Foodi settings.' },
  { href: '/cosori', title: 'Cosori', spec: 'Max 450°F · 11 presets', desc: 'Maps the built-in preset buttons to real times.' },
  { href: '/philips', title: 'Philips', spec: 'Max 390°F · Rapid Air', desc: 'Lower ceiling than most — times run longer.' },
  { href: '/model-max-temp', title: 'Model max-temp reference', spec: '60+ models', desc: 'The ceiling table that feeds the converter above.' },
];

const chartStrip = ['Food-type multipliers', 'Basket & oven-style', '°F · °C · gas mark', 'Free — no account'];

const homeDescription =
  'Free oven to air fryer converter. Convert oven temperature and time to air fryer settings by food type and basket vs. oven-style — no flat 25° guesswork, no sign-up.';

const homeKeywords =
  'oven to air fryer converter, oven to air fryer conversion, conventional oven to air fryer conversion, convert oven to air fryer, oven to air fryer cooking time conversion, air fryer to oven conversion, convert air fryer to oven, air fryer to oven calculator, air fryer conversion chart, air fryer temperature chart, air fryer cooking times, air fryer calculator';
---

<Layout
  title="Oven to Air Fryer Converter"
  description={homeDescription}
  canonical={siteConfig.domain}
  keywords={homeKeywords}
  jsonLd={jsonLd}
>
  <SiteNav currentPath="/" />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Free / No sign-up / Works offline</p>
        <h1 class="hero-title">Oven to Air Fryer Converter</h1>
        <p class="hero-sub">
          Enter the temperature and time on the recipe. Get the air fryer setting for your food,
          adjusted for basket or oven-style — not a flat 25° rule.
        </p>

        <div class="hero-grid">
          <!-- Live widget -->
          <ConverterWidget>
            <a href="/oven-to-air-fryer" class="cta">Open the full converter <span aria-hidden="true">&rarr;</span></a>
          </ConverterWidget>

          <!-- Common conversions rail -->
          <div class="rail">
            <p class="eyebrow">Common conversions</p>
            <div class="rail-list">
              {commonConversions.map((c, i) => (
                <a href={c.href} class:list={['rail-item', { first: i === 0 }]}>
                  <span class="rail-num">{c.from}</span>
                  <span class="rail-arrow">&rarr;</span>
                  <span class="rail-num">{c.to}</span>
                  <span class="rail-note">{c.note}</span>
                </a>
              ))}
            </div>
            <p class="rail-footnote">Multipliers tuned for basket and oven-style air fryers, per food type.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Convert -->
    <section id="convert" class="section">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Convert</h2>
        <div class="card-grid">
          {convertCards.map((c) => (
            <a href={c.href} class="card">
              <span class="card-title">{c.dot && <span class="title-dot inline"></span>}{c.title}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Reverse -->
    <section id="reverse" class="section">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Reverse convert</h2>
        <div class="card-grid">
          {reverseCards.map((c) => (
            <a href={c.href} class="card">
              <span class="card-title">{c.title}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Frozen -->
    <section id="frozen" class="section">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Frozen food mode</h2>
        <div class="teaser">
          <div class="teaser-row">
            <div class="teaser-copy">
              <span class="teaser-heading">Frozen straight from the bag</span>
              <span class="teaser-desc">Keep the package temperature, cut about 30% of the time — the opposite of the standard rule. Pick what you are cooking.</span>
            </div>
            <div class="teaser-action">
              <select aria-label="Select a frozen food">
                <option>Frozen french fries</option>
                <option>Frozen chicken nuggets</option>
                <option>Frozen chicken breast</option>
                <option>Frozen pizza</option>
                <option>Frozen fish sticks</option>
              </select>
              <a href="/frozen" class="go-btn">Go</a>
            </div>
          </div>
        </div>
        <div class="card-grid">
          {frozenCards.map((c) => (
            <a href={c.href} class="card">
              <span class="card-title small">{c.title}</span>
              <span class="card-spec">{c.spec}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Presets -->
    <section id="presets" class="section">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Food presets</h2>
        <div class="teaser">
          <div class="teaser-row">
            <div class="teaser-copy">
              <span class="teaser-heading">Time and temperature for one specific food</span>
              <span class="teaser-desc">Every preset gives temperature, time, shake or flip points, and doneness cues. No recipe blog to scroll.</span>
            </div>
            <div class="teaser-action">
              <select aria-label="Select a food preset">
                <option>Chicken breast</option>
                <option>Chicken wings</option>
                <option>Salmon fillet</option>
                <option>Bacon</option>
                <option>Steak</option>
              </select>
              <a href="/presets" class="go-btn">Go</a>
            </div>
          </div>
        </div>
        <div class="card-grid">
          {presetCards.map((c) => (
            <a href={c.href} class="card">
              <span class="card-title small">{c.title}</span>
              <span class="card-spec">{c.spec}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
          <a href="/presets" class="card outline">
            <span class="card-title small">All 40 presets &rarr;</span>
            <span class="card-desc">Meat, fish, vegetables, baking, reheating.</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Brands -->
    <section id="brands" class="section pad-lg">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Brand presets</h2>
        <div class="card-grid">
          {brandCards.map((c) => (
            <a href={c.href} class="card">
              <span class="card-title small">{c.title}</span>
              <span class="card-spec">{c.spec}</span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Chart strip -->
    <section id="chart" class="chart-strip">
      <div class="chart-grid">
        {chartStrip.map((label, i) => (
          <div class:list={['chart-cell', { border: i > 0 }]}>{label}</div>
        ))}
      </div>
    </section>

    <!-- SEO guide -->
    <section id="guide" class="section pad-lg guide">
      <div class="wrap">
        <h2 class="section-title"><span class="title-dot"></span>Guide</h2>
        <div class="prose">
          <h3>What Is an Oven to Air Fryer Converter?</h3>
          <p>
            An <strong>oven to air fryer converter</strong> takes the temperature and time from a conventional
            oven recipe and translates it into the matching air fryer setting — so a recipe written for a 425°F
            oven doesn't come out with burnt edges and a raw center just because it was cooked in a basket
            instead. It's built for the moment every home cook eventually hits: a favorite recipe lists an oven
            temperature and bake time, but firing up the whole oven feels like overkill for four chicken thighs
            or a tray of fries, and the air fryer on the counter can do the job faster and with less energy — if
            you know what settings to use. That's the gap this tool closes. Enter the oven temperature and time
            from the recipe, say what you're cooking and whether your unit is a basket or an oven-style air
            fryer, and it returns a setting that actually matches how air fryers cook.
          </p>

          <h3>How Oven to Air Fryer Conversion Works</h3>
          <p>
            Most <strong>oven to air fryer conversion</strong> advice online reduces to one line: subtract 25°F
            and cut the time by a fifth. That rule isn't wrong exactly — air fryers are small, forced-air
            convection ovens, so they transfer heat faster and need both a lower temperature and a shorter cook
            time than a conventional oven. But treating every food the same way is where flat rules break down.
            A flat rule assumes a tray of thin-cut fries and a dense loaf of banana bread respond to faster
            airflow identically. They don't. Thin, high-surface-area foods like fries, bacon, and chicken wings
            are surrounded by hot air on nearly every side, so they cook dramatically faster — often needing
            25–30% less time. A dense casserole or a thick cut of meat still has to conduct heat to its center
            the same way it would in an oven, so the savings are smaller, closer to 10–15%. Apply the fries
            multiplier to the casserole and you'll pull it out underdone; apply the casserole multiplier to the
            fries and you'll dry them out. That's why a proper <strong>conventional oven to air fryer
            conversion</strong> needs a multiplier per food category instead of one number for everything — the
            converter above looks at what you selected and applies the time reduction that food type actually
            needs, alongside the standard temperature drop.
          </p>

          <h3>Step by Step: How to Convert Oven to Air Fryer</h3>
          <p>
            To <strong>convert oven to air fryer</strong> settings for any recipe: enter the oven temperature
            exactly as written, enter the oven bake time, pick the closest food type, then select whether your
            appliance is a basket-style air fryer or an oven-style unit (an air fryer oven or toaster-oven
            hybrid). The tool drops the temperature, applies the correct food-type time multiplier, and checks
            the result against what your specific appliance can actually reach — so you never get a number that
            doesn't exist on your dial.
          </p>

          <h3>Oven to Air Fryer Cooking Time Conversion</h3>
          <p>
            Temperature is only half the job — <strong>oven to air fryer cooking time conversion</strong>
            matters just as much, and it's the part flat-rule calculators usually get wrong. Because air fryers
            circulate hot air directly around food in a small chamber, heat reaches the surface faster and
            cooking finishes sooner even at a lower temperature. That's why a 45-minute oven bake might become a
            32-minute air fryer cook rather than a simple percentage of the original number: the time reduction
            scales with how much surface area the food exposes to that airflow, not just with the temperature
            change.
          </p>

          <h3>Air Fryer to Oven Conversion (Going the Other Way)</h3>
          <p>
            Conversion works in both directions. Sometimes you have an air fryer recipe or a preset from your
            appliance's manual and need to <strong>convert air fryer to oven</strong> settings instead — because
            you're cooking a bigger batch than the basket can hold, the air fryer is already busy with something
            else, or you're feeding a table using the full-size oven. <strong>Air fryer to oven conversion</strong>
            generally means raising the temperature and adding back cooking time, since a conventional oven's
            larger cavity and slower airflow can't match the air fryer's concentrated heat. An
            <strong>air fryer to oven calculator</strong> applies this in reverse: add roughly 25°F back to the
            air fryer temperature, then extend the time by the same food-type-aware percentage the forward
            conversion subtracted. It's the same underlying logic, run backward, and it's just as sensitive to
            food type — a batch of nuggets scaled up for the oven needs a different time adjustment than a whole
            chicken would.
          </p>

          <h3>Basket vs. Oven-Style Air Fryers</h3>
          <p>
            Not all air fryers behave the same, which is why this converter asks which type you own before
            finishing the conversion. Basket-style air fryers pack food into a small, sealed chamber with air
            moving on every side — that's what makes them fast, but it also means most models cap out around
            400°F, and pushing past that ceiling isn't realistic no matter what a generic calculator suggests.
            Oven-style air fryers (including air fryer ovens and toaster-oven-style baskets) have more air
            volume around the food, so the effect is gentler: temperatures can run a little higher, up to around
            450°F, before hitting a practical ceiling. Feeding your appliance type into the conversion, instead
            of ignoring it, is what keeps the output realistic.
          </p>

          <h3>Tips for Getting the Best Results</h3>
          <p>
            A few things help any <strong>oven to air fryer converter</strong> output land closer to right on
            the first try. Preheat briefly — about 3 minutes for a basket, 4 for oven-style — since air fryers
            lose more relative heat than an oven does when the door or drawer opens. Don't overcrowd the basket;
            a single, mostly uncrowded layer is what the food-type multipliers assume, and a packed basket needs
            extra time closer to what a full oven would. Check food a few minutes before the converted time
            suggests, especially the first time you're converting a new recipe, since wattage and calibration
            vary between air fryer models. And treat frozen food differently — it follows the opposite pattern
            from a fresh recipe, keeping close to the package temperature while still cutting time, since the
            food needs the initial heat just to thaw before it can cook through.
          </p>

          <h3>Free, Instant, and Built for Every Recipe</h3>
          <p>
            This oven to air fryer converter runs entirely in the browser — there's no account, no email gate,
            and no data leaves your device. Use it for a one-off recipe with the calculator above, bookmark it
            for the air fryer conversion chart and food presets throughout this site, or come back any time you
            need to convert oven to air fryer or air fryer to oven settings, so every conventional recipe has a
            fast, accurate path to the basket.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference '../styles/global.css';

  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .eyebrow {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--site-text-muted);
    margin: 0 0 24px;
  }

  /* Hero */
