    font-size: 15px;
    cursor: pointer;
  }

  .go-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    height: 44px;
    border-radius: 6px;
    background: var(--site-accent);
    color: var(--site-text);
    font-size: 15px;
