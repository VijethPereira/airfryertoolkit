    background: var(--site-accent-hover);
    color: var(--site-text);
  }

  /* Rail */
  .rail {
    flex: 0 1 320px;
    min-width: 260px;
  }

  .rail-list {
    display: flex;
    flex-direction: column;
  }

  .rail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 4px;
    border-top: 1px solid var(--site-border);
    border-bottom: 1px solid var(--site-border);
    margin-bottom: -1px;
    color: var(--site-text);
    transition: background 0.15s ease;
  }

