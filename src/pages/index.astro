    background: var(--site-bg);
    padding: 64px 0 80px;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5.6vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.92;
