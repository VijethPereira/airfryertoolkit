---
import '../styles/global.css';
import siteConfig from '../site.config.ts';
import { DEFAULT_LOCALE, LOCALES, OG_LOCALE_MAP, type LocaleCode } from '../i18n/locales';
import { localizedUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: LocaleCode;
  /** Path (starting with "/") of this page's translated slug, e.g. "/" or "/oven-to-air-fryer". Omit on pages that only exist in English — no hreflang block is rendered. */
  translatedSlug?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  keywords,
  jsonLd,
  locale = DEFAULT_LOCALE,
  translatedSlug,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteConfig.siteName}` : siteConfig.siteName;
const metaDesc = description ?? siteConfig.tagline;
const canonicalUrl = canonical ?? `${siteConfig.domain}/`;
const ogImg = ogImage ?? `${siteConfig.domain}/og-image.png`;
const jsonLdStr = jsonLd ? JSON.stringify(jsonLd) : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Prevent flash of wrong theme — must run before CSS is painted -->
    <script is:inline>
      (function(){
        var s=localStorage.getItem('theme');
        var p=window.matchMedia('(prefers-color-scheme: dark)').matches;
        if(s==='dark'||(!s&&p)) document.documentElement.classList.add('dark');
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    {translatedSlug !== undefined && (
      <>
        {LOCALES.map((l) => (
          <link rel="alternate" hreflang={l.code} href={localizedUrl(l.code, translatedSlug)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={localizedUrl(DEFAULT_LOCALE, translatedSlug)} />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Oven-fryer" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Archivo — the site's single typeface, weights 400/600 only -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={OG_LOCALE_MAP[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- JSON-LD structured data -->
    {jsonLdStr && <script is:inline type="application/ld+json" set:html={jsonLdStr} />}

    <!-- Google Analytics -->
    {siteConfig.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaId}`}></script>
        <script is:inline define:vars={{ gaId: siteConfig.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Google AdSense -->
    {siteConfig.adsenseId && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsenseId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Extra head content (per-page overrides) -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
