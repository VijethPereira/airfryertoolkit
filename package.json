  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.4.5",
    "mimetext": "^3.0.28",
    "tailwindcss": "4.3.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "wrangler": "^4.112.0"
  }
}
